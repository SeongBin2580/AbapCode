    PERFORM com_alv_display_grid     USING go_grid_5010
                                           gs_layout_5010
                                           gs_vari_5010
                                           gt_tool_5010
                                           gt_fieldcat_5010
                                           gt_sort_5010
                                           gt_s5010[].

  ELSE.

    PERFORM com_alv_refresh_grid     USING go_grid_5010.
