FORM compare_view_domain .

  DATA: lv_versno      TYPE vrsd-versno.

  lv_versno      = '00000'.

  SUBMIT radvvdo2
          WITH objname  = gs_h_data-objname
          WITH versno1  = lv_versno
          WITH versno2  = lv_versno
          WITH log_dest = destination
          WITH rem_syst = remote_system
          AND RETURN.

ENDFORM.                    " COMPARE_VIEW_DOMAIN
*&---------------------------------------------------------------------*
*&      Form  COMPARE_VIEW_CDS
*&---------------------------------------------------------------------*
*       CDS View / DDL Source 상세 비교 화면 호출
*----------------------------------------------------------------------*
FORM compare_view_cds .

  DATA: lv_versno TYPE vrsd-versno,
        lv_repid  TYPE sy-repid.

  lv_versno = '00000'.

  SELECT SINGLE rep_comp
    FROM versobj
    INTO lv_repid
   WHERE object  = gs_h_data-objtype
     AND versno  = '99999'
     AND actflag = 'A'.
  IF sy-subrc <> 0 OR lv_repid IS INITIAL.
    MESSAGE |비교 프로그램을 찾을 수 없습니다: { gs_h_data-objtype }| TYPE 'S' DISPLAY LIKE 'E'.
    EXIT.
  ENDIF.

  SUBMIT (lv_repid)
         WITH objname  = gs_h_data-objname
         WITH objnam2  = gs_h_data-objname
         WITH objtyp1  = gs_h_data-objtype
         WITH objtyp2  = gs_h_data-objtype
         WITH versno1  = lv_versno
         WITH versno2  = lv_versno
         WITH log_dest = destination
         WITH rem_syst = remote_system
         AND RETURN.

ENDFORM.                    " COMPARE_VIEW_CDS
*&---------------------------------------------------------------------*
*&      Form  COMPARE_VIEW_OTHERS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM compare_view_others .

  DATA: lv_versno      TYPE vrsd-versno.

  lv_versno      = '00000'.

  CASE gs_h_data-objtype.
    WHEN 'FUNC'.       gv_progid = 'RSVRSFU3'.
    WHEN OTHERS.       gv_progid = 'RSVRSRS3'.
  ENDCASE.

  SUBMIT (gv_progid)
         WITH log_dest = destination
         WITH objnam2  = gs_h_data-objname
         WITH objname  = gs_h_data-objname
         WITH objtyp1  = gs_h_data-objtype
         WITH objtyp2  = gs_h_data-objtype
         WITH rem_syst = remote_system
         AND RETURN.

ENDFORM.                    " COMPARE_VIEW_OTHERS