*&---------------------------------------------------------------------*
*& Report  YBZ_REMOTE_CHECK_PROGRAM                                    *
*&  Desc : Compare Objects With Remote Systems                         *
*----------------------------------------------------------------------*
* Version                                                              *
*   1.24 2026.06.16: CDS View(DDLS) 비교 로직 추가                     *
*   1.23 2026.06.16: RFC Destination 직접 선택 방식 추가               *
*   1.22 2021.01.19: Pick 기능 추가 : Object Compare                   *
*   1.21 2021.01.12: - Table Type,element,Domain 비교기능 추가         *
*                    - where used table(WBCROSSGT) 내 Object 추가      *
*   1.2  2020.11.18: Obj가 Function 인 경우 연관 structure 비교기능추가*
*   1.12 2020.07.30: Obj가 Function 인 경우 Function 명 출력으로 변경  *
*                    Obj 기준비교에 Function 비교기능 추가             *
*   1.11 2020.07.09: 결과 표시 단어(Text) 변경                         *
*   1.1  2020.07.07: 비교 제외 Object 추가                             *
*   1.0            : 언제인지 모름                                     *
* -------------------------------------------------------------------- *
*&---------------------------------------------------------------------*

REPORT  YBZ_REMOTE_CHECK_PROGRAM    MESSAGE-ID sb
                                    LINE-SIZE 1023.


TYPE-POOLS: seop.

CONSTANTS:
  reftype_ref_to_data      TYPE c VALUE 'D',
  reftype_ref_to_object    TYPE c VALUE 'O',

  ref_to_data              TYPE vseoclass-clsname VALUE 'DATA',
  ref_to_object            TYPE vseoclass-clsname VALUE 'OBJECT',

  src_ttypkind_generalttyp TYPE c VALUE ' ',    " allgemeiner TTYP
  src_ttypkind_rangesttyp  TYPE c VALUE 'R',    " Ranges-Typ

  rowkind_reftype          TYPE c VALUE 'R',    " Ref. auf Klasse/Interface
  rowkind_directtype       TYPE c VALUE ' ',    " direkte Typeingabe

  refkind_elemtype         TYPE c VALUE 'E',    " sp#ter: elementarer Typ
  refkind_doma             TYPE c VALUE 'D',    " Domaene
  refkind_reftype          TYPE c VALUE 'R',    " Ref. auf Klasse/Interface

  gc_tmsadm(7)                    VALUE 'TMSADM@',
  gc_tmsadm_len            TYPE i VALUE 7.

TABLES: e070, e071, tadir, tfdir.

TYPES: BEGIN OF tys_obj_name,
        name TYPE tadir-obj_name,
      END OF tys_obj_name,
      tyt_obj_name TYPE tys_obj_name OCCURS 0.

DATA: bool(1) TYPE c,
      true    LIKE bool VALUE  'X',
      false   LIKE bool VALUE ' '.

DATA: gv_repid LIKE sy-repid,
      BEGIN OF gt_include OCCURS 0,
        repid LIKE sy-repid,
      END OF gt_include.
DATA: gt_e071   LIKE TABLE OF e071            WITH HEADER LINE,
      gt_e071_t LIKE TABLE OF e071            WITH HEADER LINE,
      gt_tadir  TYPE TABLE OF tadir.

DATA: gr_trkorr   TYPE RANGE OF e071-trkorr,
      gr_trkorr_l LIKE LINE OF gr_trkorr.

DATA: gv_progid         LIKE trdir-name.

DATA: destination        LIKE rfcdes-rfcdest,
      remote_info_line   LIKE abaptext-line,
      remote_info_line_a LIKE vrsinfolna,
      remote_info_line_b LIKE vrsinfolnb,
      remote_versno      LIKE vrsd-versno,
      remote_objname     LIKE vrsd-objname,
      remote_objtype     LIKE vrsd-objtype,
      remote_system      LIKE tadir-srcsystem,
      returncode         LIKE sy-subrc.

DATA: srcsys LIKE tadir-srcsystem,
      author LIKE tadir-author,
      mslang LIKE tadir-masterlang,
      devcla LIKE tadir-devclass,
      notfnd LIKE bool.

DATA: objtype LIKE vrsd-objtype,
      objname LIKE vrsd-objname.

DATA: gs_tadir          LIKE tadir.
DATA: gv_comp_mode               LIKE sy-index VALUE 1,
      gv_ignore_case_differences LIKE bool VALUE 'X'.

DATA: gv_version_rgt LIKE vrsd-versno,
      gv_version_lft LIKE vrsd-versno,
      gv_objname_rgt LIKE vrsd-objname,
      gv_objname_lft LIKE vrsd-objname,
      gv_objtype_rgt LIKE vrsd-objtype,
      gv_objtype_lft LIKE vrsd-objtype,
      gv_logdest_lft LIKE rfcdes-rfcdest,
      gv_logdest_rgt LIKE rfcdes-rfcdest.

DATA: gt_abaptext_pri   LIKE abaptxt255 OCCURS 0 WITH HEADER LINE,
      gt_abaptext_sec   LIKE abaptxt255 OCCURS 0 WITH HEADER LINE,
      gt_trdir_pri      LIKE trdir      OCCURS 1 WITH HEADER LINE,
      gt_trdir_old      LIKE trdir_old  OCCURS 1 WITH HEADER LINE,
      gt_trdir_sec      LIKE trdir      OCCURS 1 WITH HEADER LINE,
      gt_trdir_delta    LIKE xtrdir     OCCURS 1 WITH HEADER LINE,
      gt_abaptext_delta LIKE vxabapt255 OCCURS 0 WITH HEADER LINE.

DATA: BEGIN OF gs_cnt,
        total    TYPE sy-dbcnt,
        same     TYPE sy-dbcnt,
        wrong    TYPE sy-dbcnt,
        error    TYPE sy-dbcnt,
        check    TYPE sy-dbcnt,
        together TYPE  sy-dbcnt,
      END OF gs_cnt.

DATA: BEGIN OF gs_add_table,
        obj_name     TYPE e071-obj_name,
        tabclass     TYPE dd02l-tabclass,
        domname      TYPE dd04l-domname,
      END OF gs_add_table,
      gt_add_table LIKE TABLE OF gs_add_table.

DATA: gv_obj_type TYPE trobjtype,
      gv_obj_name TYPE vrsd-objname.

DATA: gr_objnm     TYPE RANGE OF tadir-obj_name WITH HEADER LINE.
DATA: gt_inclu     TYPE tyt_obj_name.

DATA: gv_save_sy_subrc TYPE sy-subrc.

DATA: gv_inc_check.

DATA: BEGIN OF gs_h_data,
       objtype TYPE vrsd-objtype,
       objname TYPE vrsd-objname,
      END OF gs_h_data.

CLASS lcl_rfc_destination DEFINITION FINAL.
  PUBLIC SECTION.
    CLASS-METHODS value_request
      CHANGING
        cv_destination TYPE rfcdes-rfcdest.

    CLASS-METHODS validate
      IMPORTING
        iv_destination TYPE rfcdes-rfcdest.

    CLASS-METHODS get_remote_system
      IMPORTING
        iv_destination     TYPE rfcdes-rfcdest
      RETURNING
        VALUE(rv_srcsystem) TYPE tadir-srcsystem.
ENDCLASS.

CLASS lcl_rfc_destination IMPLEMENTATION.
  METHOD value_request.
    TYPES: BEGIN OF lty_rfc_dest,
             rfcdest TYPE rfcdes-rfcdest,
           END OF lty_rfc_dest.

    DATA: lt_rfc_dest TYPE STANDARD TABLE OF lty_rfc_dest,
          lt_return   TYPE STANDARD TABLE OF ddshretval.

    SELECT rfcdest
      FROM rfcdes
      INTO TABLE @lt_rfc_dest
     WHERE rfctype = '3'.

    IF lt_rfc_dest IS INITIAL.
      MESSAGE 'SM59 ABAP Connection(Type 3) RFC Destination이 없습니다.' TYPE 'I'.
      RETURN.
    ENDIF.

    SORT lt_rfc_dest BY rfcdest.

    CALL FUNCTION 'F4IF_INT_TABLE_VALUE_REQUEST'
      EXPORTING
        retfield        = 'RFCDEST'
        dynpprog        = sy-repid
        dynpnr          = sy-dynnr
        dynprofield     = 'P_DEST'
        value_org       = 'S'
      TABLES
        value_tab       = lt_rfc_dest
        return_tab      = lt_return
      EXCEPTIONS
        parameter_error = 1
        no_values_found = 2
        OTHERS          = 3.

    IF sy-subrc = 0.
      READ TABLE lt_return INTO DATA(ls_return) INDEX 1.
      IF sy-subrc = 0.
        cv_destination = ls_return-fieldval.
      ENDIF.
    ENDIF.
  ENDMETHOD.

  METHOD validate.
    SELECT SINGLE rfcdest
      FROM rfcdes
      INTO @DATA(lv_rfcdest)
     WHERE rfcdest = @iv_destination
       AND rfctype = '3'.

    IF sy-subrc <> 0.
      MESSAGE |SM59 ABAP Connection(Type 3) RFC Destination이 아닙니다: { iv_destination }| TYPE 'E'.
    ENDIF.
  ENDMETHOD.

  METHOD get_remote_system.
    DATA: lv_dummy LIKE gc_tmsadm.

    CLEAR rv_srcsystem.

    lv_dummy = iv_destination.
    IF lv_dummy = gc_tmsadm.
      rv_srcsystem = iv_destination+gc_tmsadm_len(3).
    ELSE.
      rv_srcsystem = iv_destination.
    ENDIF.
  ENDMETHOD.
ENDCLASS.

DEFINE fill_sy_langu_text1.            "Mit einem Sortierfeld
  gv_save_sy_subrc = sy-subrc.
  loop at dd&1v_tab where ddlanguage <> sy-langu.
    read table dd&1tv_tab with key
         &2 = dd&1v_tab-&2
         ddlanguage = sy-langu.
    check sy-subrc = 0.
    move-corresponding dd&1tv_tab to dd&1v_tab.
    modify dd&1v_tab.
  endloop.
  sy-subrc =  gv_save_sy_subrc.
END-OF-DEFINITION.
DEFINE fill_sy_langu_text2.             "Mit zwei Sortierfeldern
  gv_save_sy_subrc = sy-subrc.
  loop at dd&1v_tab where ddlanguage <> sy-langu.
    read table dd&1tv_tab with key
         &2 = dd&1v_tab-&2
         &3 = dd&1v_tab-&3
         ddlanguage = sy-langu.
    check sy-subrc = 0.
    move-corresponding dd&1tv_tab to dd&1v_tab.
    modify dd&1v_tab.
  endloop.
  sy-subrc =  gv_save_sy_subrc.
END-OF-DEFINITION.

DEFINE get_generic_reftype.
  clear &2.             " initialization: unknown generic reference type
  case &1.
      " old: when REF_TO_ANY.    &2 = REFTYPE_REF_TO_ANY. " uh, 12.11.2001
    when ref_to_object. &2 = reftype_ref_to_object.
    when ref_to_data.   &2 = reftype_ref_to_data.
  endcase.
END-OF-DEFINITION.

SELECTION-SCREEN BEGIN OF BLOCK b00 WITH FRAME TITLE text_000.
PARAMETERS:
      p_dest            TYPE rfcdes-rfcdest OBLIGATORY.
SELECTION-SCREEN END OF BLOCK b00.

SELECTION-SCREEN BEGIN OF BLOCK b01 WITH FRAME TITLE text_100.
PARAMETERS:
      p_reqno           LIKE e070-trkorr.
SELECT-OPTIONS:
      s_object          FOR  e071-object,
      s_objnm           FOR  e071-obj_name.
SELECTION-SCREEN END OF BLOCK b01.
SELECTION-SCREEN BEGIN OF BLOCK b02 WITH FRAME TITLE text_200.
SELECT-OPTIONS:
      s_dev             FOR  tadir-devclass.
SELECTION-SCREEN END OF BLOCK b02.
SELECTION-SCREEN BEGIN OF BLOCK b03 WITH FRAME TITLE text_300.
SELECT-OPTIONS:
      s_obj3             FOR  e071-object,
      s_objnm3           FOR  e071-obj_name.
SELECTION-SCREEN END OF BLOCK b03.

SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS:  cb_all   AS CHECKBOX.
SELECTION-SCREEN COMMENT 3(60) text_901.
SELECTION-SCREEN END OF LINE.

SELECTION-SCREEN BEGIN OF LINE.
PARAMETERS:  cb_detal   AS CHECKBOX.
SELECTION-SCREEN COMMENT 3(60) text_902.
SELECTION-SCREEN END OF LINE.

INITIALIZATION.
  PERFORM set_text.

AT SELECTION-SCREEN ON VALUE-REQUEST FOR p_dest.
  lcl_rfc_destination=>value_request(
    CHANGING
      cv_destination = p_dest ).

AT SELECTION-SCREEN ON p_dest.
  lcl_rfc_destination=>validate( p_dest ).

START-OF-SELECTION.

  CLEAR: gt_e071[], gt_inclu[].
  IF p_reqno IS NOT INITIAL.
    gv_inc_check = 'X'.
    PERFORM get_object_reqno.

  ELSEIF s_dev[] IS NOT INITIAL.
    gv_inc_check = space.
    PERFORM get_object_devclass.

  ELSEIF s_objnm3[] IS NOT INITIAL.
    gv_inc_check = space.
    PERFORM get_object_object.

  ENDIF.

  IF gt_e071[] IS INITIAL.
    MESSAGE '조회조건에 맞는 자료가 없습니다.' TYPE 'I'.
    LEAVE LIST-PROCESSING.
  ENDIF.

  SORT gt_e071 BY object obj_name.
  DELETE ADJACENT DUPLICATES FROM gt_e071
         COMPARING object obj_name.

  DATA: lv_flag,
        lv_local,
        lv_remote.

  CLEAR: gs_cnt, lv_flag.
  gs_cnt-total = LINES( gt_e071 ).

  READ TABLE gt_e071 INDEX 1.
  gv_obj_type   = gt_e071-object.
  gv_obj_name   = gt_e071-obj_name.

* 선택화면에서 지정한 RFC Destination을 직접 사용한다.
* RSVRSREM의 GET_RFC_DESTINATION을 호출하지 않으므로
* 표준 Remote System 선택/로그온 팝업을 거치지 않는다.
  destination   = p_dest.
  remote_system = lcl_rfc_destination=>get_remote_system( p_dest ).

  " 비교
  LOOP AT gt_e071.

    CASE gt_e071-object+0(3).
      WHEN 'TAB'.  PERFORM compare_table      USING gt_e071.
      WHEN 'VIE'.  PERFORM compare_view       USING gt_e071.
      WHEN 'TTY'.  PERFORM compare_tabletype  USING gt_e071.
      WHEN 'DTE'.  PERFORM compare_element    USING gt_e071.
      WHEN 'DDL'.  PERFORM compare_cds        USING gt_e071.
      WHEN 'DOM'.  PERFORM compare_domain     USING gt_e071.
      WHEN OTHERS. PERFORM compare_others     USING gt_e071.
    ENDCASE.

  ENDLOOP.

END-OF-SELECTION.
  WRITE:/ sy-uline.

  WRITE:/ `Total              :`, gs_cnt-total.
  WRITE:/ `Same               :`, gs_cnt-same.
  WRITE:/ `Different          :`, gs_cnt-wrong.
  WRITE:/ `Local Not Exist    :`, gs_cnt-error.
  WRITE:/ `Remote Not Exist   :`, gs_cnt-check.
  WRITE:/ `Together Not Exist :`, gs_cnt-together.

  WRITE:/ sy-uline.
  WRITE:/ '작업이 완료되었습니다'.

AT LINE-SELECTION.
  CASE gs_h_data-objtype+0(3).
    WHEN 'TAB'.  PERFORM compare_view_table.
    WHEN 'VIE'.  PERFORM compare_view_view.
    WHEN 'TTY'.  PERFORM compare_view_tabletype.
    WHEN 'DTE'.  PERFORM compare_view_element.
    WHEN 'DDL'.  PERFORM compare_view_cds.
    WHEN 'DOM'.  PERFORM compare_view_domain.
    WHEN OTHERS. PERFORM compare_view_others.
  ENDCASE.

*&---------------------------------------------------------------------*
*&      Form  get_system_name_remote
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->PO_SYSNAME text
*----------------------------------------------------------------------*
FORM get_system_name_remote USING po_dir_destination
                            CHANGING po_sysname.

  po_sysname = lcl_rfc_destination=>get_remote_system( po_dir_destination ).

ENDFORM.                    "get_system_name_remote
*&---------------------------------------------------------------------*
*&      Form  SET_TEXT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM set_text .

  text_000 = 'Remote System 선택'.
  text_100 = 'Request No 기준'.
  text_200 = 'DevClass 기준'.
  text_300 = 'Object 기준'.

  text_901 = `'X':전체 Object 조회,'':틀린 Object 조회`.
  text_902 = `'X':틀린 내용 조회`.

ENDFORM.                    " SET_TEXT
*&---------------------------------------------------------------------*
*&      Form  GET_OBJECT_REQNO
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM get_object_reqno .

  CLEAR: gt_e071_t[].
  SELECT trkorr object obj_name
    FROM e071
    INTO CORRESPONDING FIELDS OF TABLE gt_e071_t
   WHERE trkorr IN
       ( SELECT trkorr
           FROM e070
          WHERE ( trkorr = p_reqno AND trfunction = 'K' ) OR
                strkorr = p_reqno )
     AND pgmid    IN ('LIMU','R3TR')
     AND object   IN s_object
     AND object   IN ('FUNC', 'REPS','CLAS','PROG','CLSD','CPRI','CPUB','CPRO','METH',
                      'TABD', 'VIEW','FUGR','TTYP','TTYD','DTEL','DOMA','DOMD','DDLS')
     AND obj_name IN s_objnm .

  SELECT trkorr object obj_name
    FROM e071
    APPENDING CORRESPONDING FIELDS OF TABLE gt_e071_t
   WHERE trkorr   = p_reqno
     AND pgmid    IN ('LIMU','R3TR')
     AND object   IN s_object
     AND object   IN ('FUNC', 'REPS','CLAS','PROG','CLSD','CPRI','CPUB','CPRO','METH',
                      'TABD', 'VIEW','FUGR','TTYP','TTYD','DTEL','DOMA','DOMD','DDLS')
     AND obj_name IN s_objnm .

*  DATA: ls_e071 TYPE e071.
*  ls_e071-object = 'CLAS'.
*  MODIFY gt_e071 FROM ls_e071
*         TRANSPORTING object
*         WHERE object = 'CLSD' OR object = 'CPRI' OR object = 'CPUB'.

  CLEAR: gr_trkorr[].
  LOOP AT gt_e071_t .

    CLEAR: gr_trkorr_l.
    gr_trkorr_l-sign    = 'I'.
    gr_trkorr_l-option  = 'EQ'.
    gr_trkorr_l-low     = gt_e071_t-trkorr.

    COLLECT gr_trkorr_l INTO gr_trkorr.

  ENDLOOP.
  SORT gt_e071_t BY object obj_name.
  DELETE ADJACENT DUPLICATES FROM gt_e071_t
         COMPARING object obj_name.

  PERFORM check_object.

ENDFORM.                    " GET_OBJECT_REQNO
*&---------------------------------------------------------------------*
*&      Form  GET_OBJECT_DEVCLASS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM get_object_devclass .

  CLEAR: gr_objnm[].
  IF s_objnm[] IS NOT INITIAL.
    LOOP AT s_objnm.
      MOVE-CORRESPONDING s_objnm TO gr_objnm.
      APPEND gr_objnm.
    ENDLOOP.
  ENDIF.

  PERFORM get_devclass_table.     " table
  PERFORM get_devclass_view.      " View
  PERFORM get_devclass_tabletype. " table type
  PERFORM get_devclass_element.   " element
  PERFORM get_devclass_domain.    " domain
  PERFORM get_devclass_cds.       " CDS View / DDL Source
  PERFORM get_devclass_program.   " 프로그램
  PERFORM get_devclass_class.     " class
  PERFORM get_devclass_function.  " Function

ENDFORM.                    " GET_OBJECT_DEVCLASS
*&---------------------------------------------------------------------*
*&      Form  GET_OBJECT_OBJECT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM get_object_object .

  " 프로그램..
  SELECT pgmid
         object
         obj_name
    FROM tadir
    INTO CORRESPONDING FIELDS OF TABLE gt_e071_t
   WHERE pgmid    =  'R3TR'
     AND object   IN s_obj3
     AND obj_name IN s_objnm3
     AND delflag   = space.

  PERFORM add_function_object.
  APPEND LINES OF gt_e071 TO gt_e071_t.

  PERFORM check_object.

ENDFORM.                    " GET_OBJECT_OBJECT
*&---------------------------------------------------------------------*
*&      Form  ADD_CLASS_OBJECT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_GT_E071_T  text
*----------------------------------------------------------------------*
FORM add_class_object  USING    ps_e071 TYPE e071.


  DATA: lv_clsname    TYPE seoclsname,
        ls_result     TYPE seop_method_w_include,
        lt_result     TYPE seop_methods_w_include,
        ls_e071       TYPE e071,
        lt_e071       TYPE TABLE OF e071.

  ls_e071 = ps_e071.
  PERFORM get_object_clas TABLES lt_e071
                          USING  ls_e071-obj_name.
  APPEND LINES OF lt_e071 TO gt_e071.

*  ls_e071-object = 'CLSD'.
*  APPEND ls_e071 TO gt_e071.
*
*  ls_e071-pgmid  = 'LIUM'.
*  ls_e071-object = 'CPUB'.
*  APPEND ls_e071 TO gt_e071.
*
*  ls_e071-pgmid  = 'LIUM'.
*  ls_e071-object = 'CPRO'.
*  APPEND ls_e071 TO gt_e071.
*
*  ls_e071-pgmid  = 'LIUM'.
*  ls_e071-object = 'CPRI'.
*  APPEND ls_e071 TO gt_e071.

  " METH
  lv_clsname = ls_e071-obj_name.
  CALL METHOD cl_oo_classname_service=>get_all_method_includes
    EXPORTING
      clsname            = lv_clsname
*     with_enhancements  = SEOX_FALSE
    RECEIVING
      result             = lt_result
    EXCEPTIONS
      class_not_existing = 1
      OTHERS             = 2.

  LOOP AT lt_result INTO ls_result.

    CHECK ls_result-cpdkey-cpdname IS NOT INITIAL.

    ls_e071-pgmid    = 'LIUM'.
    ls_e071-object   = 'METH'.
    ls_e071-obj_name = ls_result-cpdkey.
    APPEND ls_e071 TO gt_e071.

    " parameter 에 CBO Type 이 있는 경우
    PERFORM add_object_method USING ls_result-cpdkey.

  ENDLOOP.

ENDFORM.                    " ADD_CLASS_OBJECT
*&---------------------------------------------------------------------*
*&      Form  ADD_OBJECT_FUNCTION
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_GT_TADIR  text
*----------------------------------------------------------------------*
FORM add_object_function  USING    ps_tadir TYPE tadir.

  CLEAR: gt_e071.
  gt_e071-pgmid  = 'LIUM'.
  gt_e071-object = 'REPS'.

  CONCATENATE 'SAPL' ps_tadir-obj_name INTO gv_repid.
  gt_e071-obj_name = gv_repid.
  COLLECT gt_e071.

  CALL FUNCTION 'RS_GET_ALL_INCLUDES'
    EXPORTING
      program      = gv_repid
    TABLES
      includetab   = gt_include
    EXCEPTIONS
      not_existent = 1
      no_program   = 2
      OTHERS       = 3.
  LOOP AT gt_include.

    CHECK gt_include-repid+0(2) = 'LZ' OR
          gt_include-repid+0(2) = 'LY'.

    SELECT COUNT( * )
      FROM trdir
      INTO sy-dbcnt
     WHERE name = gt_include-repid.
    CHECK sy-subrc = 0 AND sy-dbcnt > 0.  " Source 가 있으면.
    CLEAR: gt_e071.
    gt_e071-pgmid  = 'LIUM'.
    gt_e071-object = 'REPS'.
    gt_e071-obj_name = gt_include-repid.
    COLLECT gt_e071.

    " function 명 정보를 가지고 온다
    PERFORM find_function_name CHANGING gt_e071-obj_name gt_e071-object.
    CHECK gt_e071-object = 'FUNC'.

    " table, view, structure
    CLEAR: gt_add_table[].
    SELECT a~structure AS obj_name
           b~tabclass
      FROM fupararef AS a
           INNER JOIN dd02l AS b ON  b~tabname = a~structure
                                 AND b~as4local = 'A'
      INTO CORRESPONDING FIELDS OF TABLE gt_add_table
     WHERE a~funcname  = gt_e071-obj_name
       AND a~r3state   = 'A'
       AND a~structure <> space.
    LOOP AT gt_add_table INTO gs_add_table.
      CHECK gs_add_table-obj_name+0(1) = 'Z' OR
            gs_add_table-obj_name+0(1) = 'Y'.

      gt_e071-pgmid    = 'LIUM'.
      CASE gs_add_table-tabclass.
        WHEN 'VIEW'. gt_e071-object   = 'VIEW'.
        WHEN OTHERS. gt_e071-object   = 'TABD'.
      ENDCASE.
      gt_e071-obj_name = gs_add_table-obj_name.
      COLLECT gt_e071.
    ENDLOOP.

    " table type
    CLEAR: gt_add_table[].
    SELECT a~structure AS obj_name
      FROM fupararef AS a
           INNER JOIN dd40l AS b ON  b~typename = a~structure
                                 AND b~as4local = 'A'
      INTO CORRESPONDING FIELDS OF TABLE gt_add_table
     WHERE a~funcname  = gt_e071-obj_name
       AND a~r3state   = 'A'
       AND a~structure <> space.
    LOOP AT gt_add_table INTO gs_add_table.
      CHECK gs_add_table-obj_name+0(1) = 'Z' OR
            gs_add_table-obj_name+0(1) = 'Y'.

      gt_e071-pgmid    = 'LIUM'.
      gt_e071-object   = 'TTYP'.
      gt_e071-obj_name = gs_add_table-obj_name.
      COLLECT gt_e071.
    ENDLOOP.

    " element and domain
    CLEAR: gt_add_table[].
    SELECT a~structure AS obj_name
           b~domname
      FROM fupararef AS a
           INNER JOIN dd04l AS b ON  b~rollname = a~structure
                                 AND b~as4local = 'A'
      INTO CORRESPONDING FIELDS OF TABLE gt_add_table
      WHERE a~funcname  = gt_e071-obj_name
        AND a~r3state   = 'A'
        AND a~structure <> space.
    LOOP AT gt_add_table INTO gs_add_table.
      CHECK gs_add_table-obj_name+0(1) = 'Z' OR
            gs_add_table-obj_name+0(1) = 'Y'.

      gt_e071-pgmid    = 'LIUM'.
      gt_e071-object   = 'DTED'.
      gt_e071-obj_name = gs_add_table-obj_name.
      COLLECT gt_e071.

      CHECK gs_add_table-domname+0(1) = 'Z' OR
            gs_add_table-domname+0(1) = 'Y'.

      gt_e071-pgmid    = 'LIUM'.
      gt_e071-object   = 'DOMD'.
      gt_e071-obj_name = gs_add_table-domname.
      COLLECT gt_e071.

    ENDLOOP.
  ENDLOOP.

ENDFORM.                    " ADD_OBJECT_FUNCTION
*&---------------------------------------------------------------------*
*&      Form  ADD_PROG_OBJECT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_GT_E071_T  text
*----------------------------------------------------------------------*
FORM add_prog_object  USING   ps_e071 TYPE e071.

  DATA: ls_e071      TYPE e071,
        ls_inclu     TYPE tys_obj_name,
        lt_inclu     TYPE tyt_obj_name.

*----------------------------------------------------------------------*
  " 포함된 INCLUDE FILE 정보 가지고 오기..
  CLEAR: lt_inclu[].
  CALL FUNCTION 'GET_INCLUDETAB'
    EXPORTING
      progname = ps_e071-obj_name
    TABLES
      incltab  = lt_inclu.

  LOOP AT lt_inclu INTO ls_inclu.

    READ TABLE gt_inclu WITH KEY name = ls_inclu-name
         BINARY SEARCH TRANSPORTING NO FIELDS.
    CHECK sy-subrc NE 0.

    APPEND ls_inclu TO gt_inclu.
    SORT gt_inclu BY name.

    ls_e071-pgmid    = 'LIUM'.
    ls_e071-object   = 'REPS'.
    ls_e071-obj_name = ls_inclu-name.
    APPEND ls_e071 TO gt_e071.

    PERFORM add_where_used_list USING ls_inclu-name.

  ENDLOOP.

ENDFORM.                    " ADD_PROG_OBJECT
*&---------------------------------------------------------------------*
*&      Form  COMPARE_OTHERS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_GT_E071  text
*----------------------------------------------------------------------*
FORM compare_others  USING    ps_e071 TYPE e071.

  gv_version_rgt = '0000'.
  gv_version_lft = '0000'.
  gv_logdest_lft = space.
  gv_logdest_rgt = destination.

  CASE ps_e071-object.
    WHEN 'FUGR'.
      CONCATENATE 'SAPL' ps_e071-obj_name INTO gv_objname_rgt.
      CONCATENATE 'SAPL' ps_e071-obj_name INTO gv_objname_lft.
      gv_objtype_rgt = gv_objtype_lft = 'REPS'.

    WHEN OTHERS.
      gv_objname_rgt = ps_e071-obj_name.
      gv_objname_lft = ps_e071-obj_name.
      gv_objtype_rgt = ps_e071-object.
      gv_objtype_lft = ps_e071-object.

  ENDCASE.


  CLEAR: lv_local, lv_remote.

* local Source check.
  CALL FUNCTION 'SVRS_GET_REPS_FROM_OBJECT'
    EXPORTING
      destination = gv_logdest_lft
      object_name = gv_objname_lft
      object_type = gv_objtype_lft
      versno      = gv_version_lft
    TABLES
      repos_tab   = gt_abaptext_sec
      trdir_tab   = gt_trdir_sec
    EXCEPTIONS
      no_version  = 01.
  IF sy-subrc <> 0.
    lv_local = 'X'.
  ENDIF.

* Remote Source Check.
  CALL FUNCTION 'SVRS_GET_REPS_FROM_OBJECT'
    EXPORTING
      destination = gv_logdest_rgt
      object_name = gv_objname_rgt
      object_type = gv_objtype_rgt
      versno      = gv_version_rgt
    TABLES
      repos_tab   = gt_abaptext_pri
      trdir_tab   = gt_trdir_pri
    EXCEPTIONS
      no_version  = 01.
  IF sy-subrc <> 0.
    lv_remote = 'X'.
  ENDIF.

  IF ps_e071-obj_name+0(2) = 'LZ' OR ps_e071-obj_name+0(2) = 'LY'.
    PERFORM find_function_name CHANGING ps_e071-obj_name ps_e071-object.
  ENDIF.

  DATA: lv_exit.
  PERFORM write_message USING    ps_e071 lv_local lv_remote
                        CHANGING lv_exit.
  CHECK lv_exit IS INITIAL.

* Source 비교..
  CALL FUNCTION 'SVRS_COMPUTE_DELTA_REPS'
    EXPORTING
      compare_mode            = gv_comp_mode
      ignore_case_differences = gv_ignore_case_differences
    TABLES
      texttab_old             = gt_abaptext_sec
      texttab_new             = gt_abaptext_pri
      trdirtab_old            = gt_trdir_sec
      trdirtab_new            = gt_trdir_pri
      trdir_delta             = gt_trdir_delta
      text_delta              = gt_abaptext_delta.

  READ TABLE gt_abaptext_delta INDEX 1 TRANSPORTING NO FIELDS.
  IF sy-subrc <> 0.
    IF cb_all = 'X'.
      PERFORM write_message_same USING ps_e071-obj_name ps_e071-object.
    ENDIF.
    ADD 1 TO gs_cnt-same.
    EXIT.
  ENDIF.

  PERFORM write_message_different USING ps_e071-obj_name ps_e071-object.

*  상세출력여부..
  CHECK cb_detal = 'X'.

*  source 가 틀린경우 화면에 출력 한다..
  CASE ps_e071-object.
    WHEN 'FUNC'.       gv_progid = 'RSVRSFU3'.
    WHEN OTHERS.       gv_progid = 'RSVRSRS3'.
  ENDCASE.

  SUBMIT (gv_progid)
         WITH log_dest = destination
         WITH objnam2  = ps_e071-obj_name
         WITH objname  = ps_e071-obj_name
         WITH objtyp1  = ps_e071-object
         WITH objtyp2  = ps_e071-object
         WITH rem_syst = remote_system
         AND RETURN.

ENDFORM.                    " COMPARE_OTHERS
*&---------------------------------------------------------------------*
*&      Form  COMPARE_CDS
*&---------------------------------------------------------------------*
*       CDS View / DDL Source active version 비교
*----------------------------------------------------------------------*
FORM compare_cds  USING    ps_e071 TYPE e071.

  DATA: ls_local       TYPE svrs2_versionable_object,
        ls_remote      TYPE svrs2_versionable_object,
        ls_delta       TYPE svrs2_xversionable_object,
        lv_local       TYPE c,
        lv_remote      TYPE c,
        lv_exit        TYPE c,
        lv_delta_empty TYPE c.

  CLEAR: ls_local, ls_remote, ls_delta,
         lv_local, lv_remote, lv_exit, lv_delta_empty.

  PERFORM read_version_object
          USING    ps_e071
                   space
          CHANGING ls_local
                   lv_local.

  PERFORM read_version_object
          USING    ps_e071
                   destination
          CHANGING ls_remote
                   lv_remote.

  PERFORM write_message USING    ps_e071 lv_local lv_remote
                        CHANGING lv_exit.
  CHECK lv_exit IS INITIAL.

  PERFORM clear_version_admin CHANGING ls_local.
  PERFORM clear_version_admin CHANGING ls_remote.

  CALL FUNCTION 'SVRS_MAKE_OBJECT_DELTA'
    EXPORTING
      obj_old = ls_local
      obj_new = ls_remote
    CHANGING
      delta   = ls_delta
    EXCEPTIONS
      OTHERS  = 1.
  IF sy-subrc <> 0.
    PERFORM write_message_different USING ps_e071-obj_name ps_e071-object.
    EXIT.
  ENDIF.

  CALL FUNCTION 'SVRS_CHECK_DELTA_EMPTY'
    EXPORTING
      obj_new       = ls_local
      delta         = ls_delta
    IMPORTING
      p_delta_empty = lv_delta_empty.

  IF lv_delta_empty = 'X'.
    IF cb_all = 'X'.
      PERFORM write_message_same USING ps_e071-obj_name ps_e071-object.
    ENDIF.
    ADD 1 TO gs_cnt-same.
    EXIT.
  ENDIF.

  PERFORM write_message_different USING ps_e071-obj_name ps_e071-object.

* 상세출력여부
  CHECK cb_detal = 'X'.
  PERFORM compare_view_cds.

ENDFORM.                    " COMPARE_CDS
*&---------------------------------------------------------------------*
*&      Form  READ_VERSION_OBJECT
*&---------------------------------------------------------------------*
*       SVRS active version object 조회
*----------------------------------------------------------------------*
FORM read_version_object  USING    ps_e071 TYPE e071
                                   pv_dest TYPE rfcdes-rfcdest
                          CHANGING cs_verobj TYPE svrs2_versionable_object
                                   cv_not_found TYPE c.

  CLEAR: cs_verobj, cv_not_found.

  cs_verobj-destination = pv_dest.
  cs_verobj-objtype     = ps_e071-object.
  cs_verobj-objname     = ps_e071-obj_name.
  cs_verobj-versno      = '00000'.

  CALL FUNCTION 'SVRS_GET_VERSION'
    CHANGING
      object              = cs_verobj
    EXCEPTIONS
      communication_error = 1
      system_error        = 2
      no_version          = 3
      version_unreadable  = 4
      OTHERS              = 5.
  IF sy-subrc <> 0.
    CLEAR cs_verobj.
    cv_not_found = 'X'.
  ENDIF.

ENDFORM.                    " READ_VERSION_OBJECT
*&---------------------------------------------------------------------*
*&      Form  CLEAR_VERSION_ADMIN
*&---------------------------------------------------------------------*
*       시스템별 변경자/변경일시 등 비교 제외 필드 초기화
*----------------------------------------------------------------------*
FORM clear_version_admin  CHANGING cs_verobj TYPE svrs2_versionable_object.

  DATA: lv_type       TYPE c,
        lv_components TYPE i.

  FIELD-SYMBOLS: <ls_part>  TYPE any,
                 <lt_table> TYPE ANY TABLE,
                 <ls_row>   TYPE any.

  IF cs_verobj IS INITIAL.
    EXIT.
  ENDIF.

  IF cs_verobj-data_pointer IS INITIAL.
    cs_verobj-data_pointer = cs_verobj-objtype.
  ENDIF.

  ASSIGN COMPONENT cs_verobj-data_pointer OF STRUCTURE cs_verobj TO <ls_part>.
  CHECK sy-subrc = 0.

  PERFORM clear_structure_field USING: <ls_part> 'MDLOG',
                                       <ls_part> 'TRDIR',
                                       <ls_part> 'TFDIR',
                                       <ls_part> 'TRDIRT',
                                       <ls_part> 'CLASS'.

  DESCRIBE FIELD <ls_part> TYPE lv_type COMPONENTS lv_components.

  DO lv_components TIMES.
    ASSIGN COMPONENT sy-index OF STRUCTURE <ls_part> TO <lt_table>.
    CHECK sy-subrc = 0.

    LOOP AT <lt_table> ASSIGNING <ls_row>.
      PERFORM clear_structure_field USING: <ls_row> 'AUTHOR',
                                           <ls_row> 'AUTH',
                                           <ls_row> 'CREATEDON',
                                           <ls_row> 'CHANGEDBY',
                                           <ls_row> 'CHANGEDON',
                                           <ls_row> 'UDATE',
                                           <ls_row> 'UTIME',
                                           <ls_row> 'AS4DATE',
                                           <ls_row> 'AS4TIME',
                                           <ls_row> 'AS4USER',
                                           <ls_row> 'DESCRIPT',
                                           <ls_row> 'EDITORDER',
                                           <ls_row> 'R3RELEASE'.
    ENDLOOP.
  ENDDO.

ENDFORM.                    " CLEAR_VERSION_ADMIN
*&---------------------------------------------------------------------*
*&      Form  CLEAR_STRUCTURE_FIELD
*&---------------------------------------------------------------------*
*       동적 구조 필드 초기화
*----------------------------------------------------------------------*
FORM clear_structure_field  USING    ps_stru
                                     pv_field.

  FIELD-SYMBOLS: <lv_value> TYPE any.

  ASSIGN COMPONENT pv_field OF STRUCTURE ps_stru TO <lv_value>.
  CHECK sy-subrc = 0.

  CLEAR <lv_value>.

ENDFORM.                    " CLEAR_STRUCTURE_FIELD
*&---------------------------------------------------------------------*
*&      Form  COMPARE_TABLE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_GT_E071  text
*----------------------------------------------------------------------*
FORM compare_table  USING    ps_e071 TYPE e071.

  DATA: lv_object_name TYPE vrsd-objname,
        lv_versno      TYPE vrsd-versno,
        lv_rc_l        TYPE sy-subrc,
        lv_rc_r        TYPE sy-subrc,
        lt_dd02vd_l    TYPE TABLE OF dd02vd,
        lt_dd03v_l     TYPE TABLE OF dd03v,
        lt_dd05m_l     TYPE TABLE OF dd05m,
        lt_dd08v_l     TYPE TABLE OF dd08v,
        lt_dd35v_l     TYPE TABLE OF dd35v,
        lt_dd36v_l     TYPE TABLE OF dd36v,
        lt_dd02vd_r    TYPE TABLE OF dd02vd,
        lt_dd03v_r     TYPE TABLE OF dd03v,
        lt_dd05m_r     TYPE TABLE OF dd05m,
        lt_dd08v_r     TYPE TABLE OF dd08v,
        lt_dd35v_r     TYPE TABLE OF dd35v,
        lt_dd36v_r     TYPE TABLE OF dd36v.

  lv_object_name = ps_e071-obj_name.
  lv_versno      = '00000'.

  CLEAR: lv_local, lv_remote.

  " local table 정보 가지고 오기
  PERFORM obj_read_table                                    "(radvvtb2)
          TABLES   lt_dd02vd_l lt_dd03v_l
                   lt_dd05m_l  lt_dd08v_l
                   lt_dd35v_l  lt_dd36v_l
          USING    lv_object_name lv_versno space space
          CHANGING lv_rc_l.
  IF lv_rc_l IS NOT INITIAL.
    lv_local = 'X'.
  ENDIF.

  " remote
  PERFORM obj_read_table                                    "(radvvtb2)
          TABLES   lt_dd02vd_r lt_dd03v_r
                   lt_dd05m_r  lt_dd08v_r
                   lt_dd35v_r  lt_dd36v_r
          USING    lv_object_name lv_versno destination space
          CHANGING lv_rc_r.
  IF lv_rc_r IS NOT INITIAL.
    lv_remote = 'X'.
  ENDIF.

  DATA: lv_exit.
  PERFORM write_message USING    ps_e071 lv_local lv_remote
                        CHANGING lv_exit.
  CHECK lv_exit IS INITIAL.

  " table 비교
  IF lt_dd02vd_l[] = lt_dd02vd_r[] AND lt_dd03v_l[]  = lt_dd03v_r[]  AND
     lt_dd05m_l[]  = lt_dd05m_r[]  AND lt_dd08v_l[]  = lt_dd08v_r[]  AND
     lt_dd35v_l[]  = lt_dd35v_r[]  AND lt_dd36v_l[]  = lt_dd36v_r[].

    IF cb_all = 'X'.
      PERFORM write_message_same USING ps_e071-obj_name ps_e071-object.
    ENDIF.
    ADD 1 TO gs_cnt-same.
    EXIT.
  ENDIF.

  PERFORM write_message_different USING ps_e071-obj_name ps_e071-object.

*  상세출력여부..
  CHECK cb_detal = 'X'.

  SUBMIT rsvrstb2
          WITH objname  = lv_object_name
          WITH versno1  = lv_versno
          WITH versno2  = lv_versno
          WITH log_dest = destination
          WITH rem_syst = remote_system
          AND RETURN.

ENDFORM.                    " COMPARE_TABLE
*&---------------------------------------------------------------------*
*&      Form  OBJ_READ_TABLE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->DD02VD_TAB text
*      -->DD03V_TAB  text
*      -->DD05M_TAB  text
*      -->DD08V_TAB  text
*      -->DD35V_TAB  text
*      -->DD36V_TAB  text
*      -->OBJNAME    text
*      -->VERSNO     text
*      -->LOG_DEST   text
*      -->FROM_MEM   text
*      -->RC         text
*----------------------------------------------------------------------*
FORM obj_read_table
     TABLES dd02vd_tab STRUCTURE dd02vd
            dd03v_tab STRUCTURE dd03v
            dd05m_tab STRUCTURE dd05m
            dd08v_tab STRUCTURE dd08v
            dd35v_tab STRUCTURE dd35v
            dd36v_tab STRUCTURE dd36v
      USING objname versno log_dest from_mem
      CHANGING rc.

  DATA dd05v_tab LIKE dd05v OCCURS 0 WITH HEADER LINE.
  DATA dd02v_tab LIKE dd02v OCCURS 0 WITH HEADER LINE.
  DATA dd03k_tab LIKE dd03k OCCURS 0 WITH HEADER LINE.
  DATA dd36m_tab LIKE dd36m OCCURS 0 WITH HEADER LINE.
  DATA dd02tv_tab LIKE dd02tv OCCURS 0 WITH HEADER LINE.
  DATA dd03tv_tab LIKE dd03tv OCCURS 0 WITH HEADER LINE.
  DATA dd08tv_tab LIKE dd08tv OCCURS 0 WITH HEADER LINE.

  CLEAR: rc.

  IF from_mem <> space.                " SN: Importieren aus Memory
*    IMPORT dd02v_tab dd03v_tab dd05m_tab dd08v_tab
*           dd35v_tab dd36m_tab FROM MEMORY
*           ID %memoryid.
*    rc = 2 * sy-subrc.
* Lesen der ersten Version in die DDxxV_TAB-Tabellen
  ELSE.
    CALL FUNCTION 'SVRS_GET_VERSION_TABD_40'
         EXPORTING
              destination = log_dest
              object_name = objname
              versno = versno
*      IMPORTING
*           INFO_LINE = I01
         TABLES
              dd02v_tab = dd02v_tab
              dd03v_tab = dd03v_tab
              dd05v_tab = dd05v_tab
              dd08v_tab = dd08v_tab
              dd35v_tab = dd35v_tab
              dd36v_tab = dd36v_tab
              dd02tv_tab = dd02tv_tab
              dd03tv_tab = dd03tv_tab
              dd08tv_tab = dd08tv_tab
         EXCEPTIONS
              no_version = 01
              system_failure = 02
              communication_failure = 03.
    fill_sy_langu_text1 02 tabname.
    fill_sy_langu_text2 03 tabname fieldname.
    fill_sy_langu_text2 08 tabname fieldname.

    " 2021.01.27 : element text 가 틀린것은 에러에서 제외한다
    dd03v_tab-ddtext = space.
    MODIFY dd03v_tab
           TRANSPORTING ddtext
           WHERE ddtext <> dd03v_tab-ddtext.
  ENDIF.
  IF sy-subrc <> 0.
* MSG DA401: Version & von & nicht gefunden
*    MESSAGE e401 WITH versno objname.
    rc = 1.
    EXIT.
  ENDIF.

  SORT dd03v_tab BY position.
  SORT dd05v_tab BY tabname fieldname primpos.
* DD02V auf DD02VD mappen.
  LOOP AT dd02v_tab.
    MOVE-CORRESPONDING dd02v_tab TO dd02vd_tab.
    PERFORM get_fv_text(radvvutl) USING 'TABCLASS' dd02v_tab-tabclass
            CHANGING dd02vd_tab-tabcltext sy-subrc.
    PERFORM get_fv_text(radvvutl) USING 'MAINTFLAG' dd02v_tab-mainflag
         CHANGING dd02vd_tab-maintflagtxt sy-subrc.
    PERFORM get_fv_text(radvvutl) USING 'DDRANKING' dd02v_tab-exclass
            CHANGING dd02vd_tab-exclasstxt sy-subrc.
    " set additional fields for display
    IF dd02v_tab-tabclass = 'APPEND'.      " append structure
      dd02vd_tab-apptab = dd02v_tab-sqltab.
    ENDIF.
    IF dd02v_tab-tabclass = 'INTTAB'       " LOB handle structure
    AND dd02vd_tab-sqltab IS NOT INITIAL.
*      dd02vd_tab-basetype = dd02v_tab-sqltab.
    ENDIF.
    APPEND dd02vd_tab.
  ENDLOOP.
* Alte Fremdschl#sseldefinition auf neue mappen.
  CALL FUNCTION 'DD_MAP_TO_FRKART_AND_CARDLEFT'
    TABLES
      dd08v_tab = dd08v_tab.
*   Die DD05M_TAB aufbauen !!!
  IF from_mem = space.
    PERFORM convert_05(saplsdtb)
            TABLES dd08v_tab dd05v_tab
                   dd05m_tab.
  ENDIF.
* Falls die Schl#sselfelder nicht mehr passen:
  LOOP AT dd05m_tab WHERE domname = space AND checkfield = space.
    dd05m_tab-domname = ' ??? '(001).
    dd05m_tab-checkfield = ' ??? '(001).
    MODIFY dd05m_tab.
  ENDLOOP.
* Jetzt noch so sortieren, daß per binary search zugegriffen
* werden kann.
  SORT dd05m_tab BY tabname fieldname primpos.
* Felder mit .INCLU--AP sollen als .APPEND erscheinen.
* und Includierte Tabellen sollen ins Datenelement.
  LOOP AT dd03v_tab WHERE fieldname(6) = '.INCLU'
                       OR fieldname = '.APPEND'.
    dd03v_tab-rollname = dd03v_tab-precfield.
    IF dd03v_tab-fieldname = '.INCLU--AP'.
      dd03v_tab-fieldname = '.APPEND'.
    ENDIF.
    MODIFY dd03v_tab.
  ENDLOOP.
  PERFORM get_typ_n_leng(radvvtb2) TABLES dd03v_tab.
  CLEAR dd03v_tab-checktable.
  MODIFY dd03v_tab TRANSPORTING checktable
         WHERE checktable = '*'.
  IF from_mem <> space.
    LOOP AT dd36m_tab WHERE shtype <> 'G'.
*     Die generischen ausschließen
      MOVE-CORRESPONDING dd36m_tab TO dd36v_tab.
      APPEND dd36v_tab.
    ENDLOOP.
  ENDIF.
ENDFORM.                    "OBJ_READ_TABLE
*&---------------------------------------------------------------------*
*&      Form  GET_DEVCLASS_TABLE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM get_devclass_table .

  SELECT obj_name
    FROM tadir
    INTO CORRESPONDING FIELDS OF TABLE gt_e071_t
   WHERE pgmid    =  'R3TR'
     AND object   =  'TABL'
     AND devclass IN s_dev
     AND obj_name IN gr_objnm
     AND delflag   = space.

  LOOP AT gt_e071_t.

    MOVE-CORRESPONDING gt_e071_t TO gt_e071.
    gt_e071-pgmid  = 'LIUM'.
    gt_e071-object = 'TABD'.
    APPEND gt_e071.

  ENDLOOP.

ENDFORM.                    " GET_DEVCLASS_TABLE
*&---------------------------------------------------------------------*
*&      Form  GET_DEVCLASS_VIEW
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM get_devclass_view .

  SELECT obj_name
    FROM tadir
    INTO CORRESPONDING FIELDS OF TABLE gt_e071_t
   WHERE pgmid    =  'R3TR'
     AND object   =  'VIEW'
     AND devclass IN s_dev
     AND obj_name IN gr_objnm
     AND delflag   = space.

  LOOP AT gt_e071_t.

    MOVE-CORRESPONDING gt_e071_t TO gt_e071.
    gt_e071-pgmid  = 'LIUM'.
    gt_e071-object = 'VIEW'.
    APPEND gt_e071.

  ENDLOOP.

ENDFORM.                    " GET_DEVCLASS_VIEW
*&---------------------------------------------------------------------*
*&      Form  GET_DEVCLASS_CDS
*&---------------------------------------------------------------------*
*       CDS View / DDL Source 조회
*----------------------------------------------------------------------*
FORM get_devclass_cds .

  SELECT obj_name
    FROM tadir
    INTO CORRESPONDING FIELDS OF TABLE gt_e071_t
   WHERE pgmid    =  'R3TR'
     AND object   =  'DDLS'
     AND devclass IN s_dev
     AND obj_name IN gr_objnm
     AND delflag   = space.

  LOOP AT gt_e071_t.

    MOVE-CORRESPONDING gt_e071_t TO gt_e071.
    gt_e071-pgmid  = 'LIUM'.
    gt_e071-object = 'DDLS'.
    APPEND gt_e071.

  ENDLOOP.

ENDFORM.                    " GET_DEVCLASS_CDS
*&---------------------------------------------------------------------*
*&      Form  GET_DEVCLASS_PROGRAM
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM get_devclass_program .

  " 프로그램..
  SELECT obj_name
    FROM tadir
    INTO CORRESPONDING FIELDS OF TABLE gt_e071_t
   WHERE pgmid    =  'R3TR'
     AND object   =  'PROG'
     AND devclass IN s_dev
     AND obj_name IN gr_objnm
     AND delflag   = space.

  LOOP AT gt_e071_t.

    MOVE-CORRESPONDING gt_e071_t TO gt_e071.
    gt_e071-pgmid  = 'LIUM'.
    gt_e071-object = 'REPS'.
    APPEND gt_e071.

    PERFORM add_prog_object USING gt_e071_t.

  ENDLOOP.

ENDFORM.                    " GET_DEVCLASS_PROGRAM
*&---------------------------------------------------------------------*
*&      Form  GET_DEVCLASS_CLASS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM get_devclass_class .

  " Class
  SELECT obj_name
    FROM tadir
    INTO CORRESPONDING FIELDS OF TABLE gt_e071_t
   WHERE pgmid    =  'R3TR'
     AND object   =  'CLAS'
     AND devclass IN s_dev
     AND obj_name IN gr_objnm
     AND delflag   = space.

  LOOP AT gt_e071_t.

    PERFORM add_class_object USING gt_e071_t.

  ENDLOOP.

ENDFORM.                    " GET_DEVCLASS_CLASS
*&---------------------------------------------------------------------*
*&      Form  GET_DEVCLASS_FUNCTION
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM get_devclass_function .

  " function
  CLEAR: gt_tadir[].
  SELECT obj_name
    FROM tadir
    INTO CORRESPONDING FIELDS OF TABLE gt_tadir
   WHERE devclass IN s_dev
     AND pgmid    = 'R3TR'
     AND object   IN ('FUGR', 'FUGS')
     AND ( obj_name LIKE 'Z%' OR obj_name LIKE 'Y%' )
     AND obj_name IN gr_objnm
     AND delflag   = space.

  DATA: ls_tadir TYPE tadir.
  LOOP AT gt_tadir INTO ls_tadir.

    PERFORM add_object_function USING ls_tadir.

  ENDLOOP.

ENDFORM.                    " GET_DEVCLASS_FUNCTION
*&---------------------------------------------------------------------*
*&      Form  COMPARE_VIEW
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_GT_E071  text
*----------------------------------------------------------------------*
FORM compare_view  USING    ps_e071 TYPE e071.

  DATA: lv_object_name TYPE vrsd-objname,
        lv_versno      TYPE vrsd-versno,
        lv_rc_l        TYPE sy-subrc,
        lv_rc_r        TYPE sy-subrc,
        lt_dd25vd_l    TYPE TABLE OF dd25vd,
        lt_dd26vd_l    TYPE TABLE OF dd26vd,
        lt_dd27vd_l    TYPE TABLE OF dd27vd,
        lt_dd28vd_l    TYPE TABLE OF dd28vd,
        lt_dd28jvd_l   TYPE TABLE OF dd28jvd,
        lt_dd25vd_r    TYPE TABLE OF dd25vd,
        lt_dd26vd_r    TYPE TABLE OF dd26vd,
        lt_dd27vd_r    TYPE TABLE OF dd27vd,
        lt_dd28vd_r    TYPE TABLE OF dd28vd,
        lt_dd28jvd_r   TYPE TABLE OF dd28jvd.


  lv_object_name = ps_e071-obj_name.
  lv_versno      = '00000'.

  CLEAR: lv_local, lv_remote.

  " local table 정보 가지고 오기
  PERFORM obj_read_view
          TABLES   lt_dd25vd_l lt_dd26vd_l  lt_dd27vd_l
                   lt_dd28vd_l lt_dd28jvd_l
          USING    lv_object_name lv_versno space
          CHANGING lv_rc_l.
  IF lv_rc_l IS NOT INITIAL.
    lv_local = 'X'.
  ENDIF.

  PERFORM obj_read_view
          TABLES   lt_dd25vd_r lt_dd26vd_r  lt_dd27vd_r
                   lt_dd28vd_r lt_dd28jvd_r
          USING    lv_object_name lv_versno destination
          CHANGING lv_rc_r.
  IF lv_rc_r IS NOT INITIAL.
    lv_remote = 'X'.
  ENDIF.

  DATA: lv_exit.
  PERFORM write_message USING    ps_e071 lv_local lv_remote
                        CHANGING lv_exit.
  CHECK lv_exit IS INITIAL.

  " table 비교
  IF lt_dd25vd_l[]  = lt_dd25vd_r[]  AND lt_dd26vd_l[] = lt_dd26vd_r[]  AND
     lt_dd27vd_l[]  = lt_dd27vd_r[]  AND lt_dd28vd_l[] = lt_dd28vd_r[]  AND
     lt_dd28jvd_l[] = lt_dd28jvd_r[].

    IF cb_all = 'X'.
      PERFORM write_message_same USING ps_e071-obj_name ps_e071-object.
    ENDIF.
    ADD 1 TO gs_cnt-same.
    EXIT.
  ENDIF.

  PERFORM write_message_different USING ps_e071-obj_name ps_e071-object.

*  상세출력여부..
  CHECK cb_detal = 'X'.

  SUBMIT rsvrsvi2
          WITH objname  = lv_object_name
          WITH versno1  = lv_versno
          WITH versno2  = lv_versno
          WITH log_dest = destination
          WITH rem_syst = remote_system
          AND RETURN.

ENDFORM.                    " COMPARE_VIEW
*&---------------------------------------------------------------------*
*&      Form  OBJ_READ_VIEW
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_LT_DD25VD_L  text
*      -->P_LT_DD26VD_L  text
*      -->P_LT_DD27VD_L  text
*      -->P_LT_DD28VD_L  text
*      -->P_LT_DD28JVD_L  text
*      -->P_LV_OBJECT_NAME  text
*      -->P_LV_VERSNO  text
*      -->P_SPACE  text
*      <--P_LV_RC_L  text
*----------------------------------------------------------------------*
FORM obj_read_view       TABLES   dd25vd_tab  STRUCTURE dd25vd
                                  dd26vd_tab  STRUCTURE dd26vd
                                  dd27vd_tab  STRUCTURE dd27vd
                                  dd28vd_tab  STRUCTURE dd28vd
                                  dd28jvd_tab STRUCTURE dd28jvd
                         USING    objname versno log_dest
                         CHANGING rc.

  DATA irc LIKE sy-subrc.
  DATA dd25v_tab LIKE dd25v OCCURS 0 WITH HEADER LINE.
  DATA dd26v_tab LIKE dd26v OCCURS 0 WITH HEADER LINE.
  DATA dd27v_tab LIKE dd27v OCCURS 0 WITH HEADER LINE.
  DATA dd28v_tab LIKE dd28v OCCURS 0 WITH HEADER LINE.
  DATA dd28v_tab2 LIKE dd28v OCCURS 0 WITH HEADER LINE.
  DATA dd28j_tab LIKE dd28j OCCURS 0 WITH HEADER LINE.
  DATA dd05m_dummy LIKE dd05m OCCURS 0 WITH HEADER LINE.
  DATA dd08v_dummy LIKE dd08v OCCURS 0 WITH HEADER LINE.
  DATA dd25tv_tab LIKE dd25tv OCCURS 0 WITH HEADER LINE.

  CLEAR: rc.

*  IF from_mem <> space.    "Import aus Memory
*    IMPORT dd25v_tab dd26v_tab dd27v_tab dd28v_tab
*           FROM MEMORY
*           ID %memoryid.
*    rc = 2 * sy-subrc.
** Lesen der ersten Version in die DDxxV_TAB-Tabellen
*  ELSE.
  CALL FUNCTION 'SVRS_GET_VERSION_VIED_40'
       EXPORTING
            destination = log_dest
            object_name = objname
            versno = versno
*      IMPORTING
*           INFO_LINE = I01
       TABLES
            dd25v_tab = dd25v_tab
            dd26v_tab = dd26v_tab
            dd27v_tab = dd27v_tab
            dd28v_tab = dd28v_tab
            dd25tv_tab = dd25tv_tab
       EXCEPTIONS
            no_version = 01.
  fill_sy_langu_text1 25 viewname.
*ENDIF.
  IF sy-subrc <> 0.
* MSG DA401: Version & von & nicht gefunden
*    MESSAGE e401 WITH versno objname.
    rc = 1.
    EXIT.
  ENDIF.

  SORT dd27v_tab BY objpos.
  LOOP AT dd25v_tab.
    MOVE-CORRESPONDING dd25v_tab TO dd25vd_tab.
    IF dd25v_tab-viewclass = 'A'.
      CLEAR dd25vd_tab-roottab.
      dd25vd_tab-appending = dd25v_tab-roottab.
    ENDIF.
    PERFORM get_fv_text(radvvutl)
            USING 'VIEWCLASS' dd25v_tab-viewclass
            CHANGING dd25vd_tab-viewcltext sy-subrc.
    PERFORM get_fv_text(radvvutl)
            USING 'VIEWGRANT' dd25v_tab-viewgrant
            CHANGING dd25vd_tab-viewgrtext sy-subrc.
    PERFORM get_fv_text(radvvutl)
            USING 'MAINTFLAG' dd25v_tab-globalflag
            CHANGING dd25vd_tab-maintflagtxt sy-subrc.
    APPEND dd25vd_tab.
  ENDLOOP.
  LOOP AT dd26v_tab.
    MOVE-CORRESPONDING dd26v_tab TO dd26vd_tab.
    APPEND dd26vd_tab.
  ENDLOOP.
  LOOP AT dd27v_tab.
    MOVE-CORRESPONDING dd27v_tab TO dd27vd_tab.
    APPEND dd27vd_tab.
  ENDLOOP.
  LOOP AT dd28v_tab WHERE negation <> 'JL' AND negation <> 'JR'.
    MOVE-CORRESPONDING dd28v_tab TO dd28vd_tab.
    CONCATENATE dd28v_tab-negation dd28v_tab-operator
                INTO dd28vd_tab-voperator.
    APPEND dd28vd_tab.
  ENDLOOP.
* Frei definierte Joinbedingungen von der DD28V in die DD28J
* transferrieren.
  PERFORM get_joins(radviact)
          TABLES dd26v_tab dd28v_tab
                 dd05m_dummy dd08v_dummy dd28j_tab dd28v_tab2
          USING 0 dd25v_tab CHANGING irc.
  LOOP AT dd28j_tab.
    MOVE-CORRESPONDING dd28j_tab TO dd28jvd_tab.
    APPEND dd28jvd_tab.
  ENDLOOP.

ENDFORM.                    " OBJ_READ_VIEW
*&---------------------------------------------------------------------*
*&      Form  ADD_FUNCTION_OBJECT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM add_function_object .

  DATA: ls_tadir      TYPE tadir,
        BEGIN OF ls_enlfdir,
          area TYPE enlfdir-area,
        END OF ls_enlfdir,
        lt_enlfdir LIKE TABLE OF ls_enlfdir.

  SELECT DISTINCT area
    FROM enlfdir
    INTO CORRESPONDING FIELDS OF TABLE lt_enlfdir
   WHERE funcname IN s_objnm3.

  LOOP AT lt_enlfdir INTO ls_enlfdir.

    ls_tadir-obj_name = ls_enlfdir-area.
    PERFORM add_object_function USING ls_tadir.

  ENDLOOP.


ENDFORM.                    " ADD_FUNCTION_OBJECT
*&---------------------------------------------------------------------*
*&      Form  FIND_FUNCTION_NAME
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      <--P_PS_E071_OBJ_NAME  text
*      <--P_PS_E071_OBJECT  text
*----------------------------------------------------------------------*
FORM find_function_name  CHANGING pv_obj_name
                                  pv_object.

  DATA: lv_pos        TYPE i,
        lv_main       TYPE tfdir-pname,
        lv_groupname  TYPE tfdir-pname,
        lv_number     TYPE tfdir-include.

  CHECK pv_obj_name+0(2) = 'LZ' OR pv_obj_name+0(2) = 'LY'.

  lv_pos = STRLEN( pv_obj_name ) - 3.
  CHECK pv_obj_name+lv_pos(1) = 'U'.

  MOVE pv_obj_name+0(lv_pos) TO lv_groupname.

  ADD  1                     TO lv_pos.
  MOVE pv_obj_name+lv_pos(2) TO lv_number.

  CONCATENATE 'SAP' lv_groupname INTO lv_main.
  SELECT SINGLE funcname
    FROM tfdir
    INTO pv_obj_name
   WHERE pname = lv_main
     AND include = lv_number.
  IF sy-subrc = 0.
    MOVE 'FUNC'      TO pv_object.
  ENDIF.

ENDFORM.                    " FIND_FUNCTION_NAME
*&---------------------------------------------------------------------*
*&      Form  CHECK_OBJECT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM check_object .

  DATA: ls_tadir TYPE tadir,
        ls_e071  TYPE e071.

  CLEAR: gt_e071[].
  " 2020.07.07 : 제외 object 추가
  DELETE gt_e071_t WHERE object = 'TRAN'.

  LOOP AT gt_e071_t.

    CASE gt_e071_t-object.
      WHEN 'CLAS'.
        PERFORM add_class_object USING gt_e071_t.

      WHEN 'PROG'.
        gt_e071_t-pgmid  = 'LIUM'.
        gt_e071_t-object = 'REPS'.
        APPEND gt_e071_t TO gt_e071.

        PERFORM add_prog_object USING gt_e071_t.

      WHEN 'FUGR' OR 'FUGS'.
        MOVE-CORRESPONDING gt_e071_t TO ls_tadir.
        PERFORM add_object_function USING ls_tadir.

      WHEN 'FUNC'.
        SELECT SINGLE area
          FROM enlfdir
          INTO ls_tadir-obj_name
         WHERE funcname = gt_e071_t-obj_name.
        PERFORM add_object_function USING ls_tadir.

      WHEN 'TABL'.
        gt_e071_t-pgmid  = 'LIUM'.
        gt_e071_t-object = 'TABD'.
        APPEND gt_e071_t TO gt_e071.

      WHEN 'DDLS'.
        gt_e071_t-pgmid  = 'LIUM'.
        APPEND gt_e071_t TO gt_e071.

      WHEN OTHERS.
        gt_e071_t-pgmid  = 'LIUM'.
        APPEND gt_e071_t TO gt_e071.
    ENDCASE.

  ENDLOOP.

ENDFORM.                    " CHECK_OBJECT
*&---------------------------------------------------------------------*
*&      Form  ADD_OBJECT_METHOD
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_LS_RESULT_CPDKEY  text
*----------------------------------------------------------------------*
FORM add_object_method  USING    ps_cpdkey   TYPE seocpdkey.

  " table, view,structure
  CLEAR: gt_add_table[].
  SELECT a~type AS obj_name
         b~tabclass
    FROM seosubcodf AS a
         INNER JOIN dd02l AS b ON  b~tabname = a~type
                               AND b~as4local = 'A'
    INTO CORRESPONDING FIELDS OF TABLE gt_add_table
   WHERE a~clsname  = ps_cpdkey-clsname
     AND a~cmpname  = ps_cpdkey-cpdname.
  LOOP AT gt_add_table INTO gs_add_table.
    CHECK gs_add_table-obj_name+0(1) = 'Z' OR
          gs_add_table-obj_name+0(1) = 'Y'.

    gt_e071-pgmid    = 'LIUM'.
    CASE gs_add_table-tabclass.
      WHEN 'VIEW'. gt_e071-object   = 'VIEW'.
      WHEN OTHERS. gt_e071-object   = 'TABD'.
    ENDCASE.
    gt_e071-obj_name = gs_add_table-obj_name.
    COLLECT gt_e071.

  ENDLOOP.

  " table type
  CLEAR: gt_add_table[].
  SELECT a~type AS obj_name
    FROM seosubcodf AS a
         INNER JOIN dd40l AS b ON  b~typename = a~type
                               AND b~as4local = 'A'
    INTO CORRESPONDING FIELDS OF TABLE gt_add_table
   WHERE a~clsname  = ps_cpdkey-clsname
     AND a~cmpname  = ps_cpdkey-cpdname.
  LOOP AT gt_add_table INTO gs_add_table.
    CHECK gs_add_table-obj_name+0(1) = 'Z' OR
          gs_add_table-obj_name+0(1) = 'Y'.

    gt_e071-pgmid    = 'LIUM'.
    gt_e071-object   = 'TTYD'.
    gt_e071-obj_name = gs_add_table-obj_name.
    COLLECT gt_e071.
  ENDLOOP.

  " element and domain
  CLEAR: gt_add_table[].
  SELECT a~type AS obj_name
         b~domname
    FROM seosubcodf AS a
         INNER JOIN dd04l AS b ON  b~rollname = a~type
                               AND b~as4local = 'A'
    INTO CORRESPONDING FIELDS OF TABLE gt_add_table
   WHERE a~clsname  = ps_cpdkey-clsname
     AND a~cmpname  = ps_cpdkey-cpdname.
  LOOP AT gt_add_table INTO gs_add_table.
    CHECK gs_add_table-obj_name+0(1) = 'Z' OR
          gs_add_table-obj_name+0(1) = 'Y'.

    gt_e071-pgmid    = 'LIUM'.
    gt_e071-object   = 'DTED'.
    gt_e071-obj_name = gs_add_table-obj_name.
    COLLECT gt_e071.

    CHECK gs_add_table-domname+0(1) = 'Z' OR
          gs_add_table-domname+0(1) = 'Y'.

    gt_e071-pgmid    = 'LIUM'.
    gt_e071-object   = 'DOMD'.
    gt_e071-obj_name = gs_add_table-domname.
    COLLECT gt_e071.
  ENDLOOP.

ENDFORM.                    " ADD_OBJECT_METHOD
*&---------------------------------------------------------------------*
*&      Form  COMPARE_TABLETYPE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_GT_E071  text
*----------------------------------------------------------------------*
FORM compare_tabletype  USING    ps_e071 TYPE e071.

  DATA: lv_object_name  TYPE vrsd-objname,
        lv_versno       TYPE vrsd-versno,
        lv_rc_l         TYPE sy-subrc,
        lv_rc_r         TYPE sy-subrc,
        lt_dd40vd_l     TYPE TABLE OF dd40vd,
        lt_dd42vd_l     TYPE TABLE OF dd42vd,
        lt_dd40vd_r     TYPE TABLE OF dd40vd,
        lt_dd42vd_r     TYPE TABLE OF dd42vd.

  lv_object_name = ps_e071-obj_name.
  lv_versno      = '00000'.

  CLEAR: lv_local, lv_remote.

  " local
  PERFORM obj_read_tabletype
          TABLES   lt_dd40vd_l lt_dd42vd_l
          USING    lv_object_name lv_versno space
                   space
          CHANGING lv_rc_l.
  IF lv_rc_l IS NOT INITIAL.
    lv_local = 'X'.
  ENDIF.

  " remote
  PERFORM obj_read_tabletype
          TABLES   lt_dd40vd_r lt_dd42vd_r
          USING    lv_object_name lv_versno destination
                   space
          CHANGING lv_rc_r.

  IF lv_rc_r IS NOT INITIAL.
    lv_remote = 'X'.
  ENDIF.

  DATA: lv_exit.
  PERFORM write_message USING    ps_e071 lv_local lv_remote
                        CHANGING lv_exit.
  CHECK lv_exit IS INITIAL.

  " table 비교
  IF lt_dd40vd_l[] = lt_dd40vd_r[] AND lt_dd42vd_l[]  = lt_dd42vd_r[].

    IF cb_all = 'X'.
      PERFORM write_message_same USING ps_e071-obj_name ps_e071-object.
    ENDIF.
    ADD 1 TO gs_cnt-same.
    EXIT.
  ENDIF.

  PERFORM write_message_different USING ps_e071-obj_name ps_e071-object.

*  상세출력여부..
  CHECK cb_detal = 'X'.

  SUBMIT radvvty2
          WITH objname  = lv_object_name
          WITH versno1  = lv_versno
          WITH versno2  = lv_versno
          WITH log_dest = destination
          WITH rem_syst = remote_system
          AND RETURN.

ENDFORM.                    " COMPARE_TABLETYPE
*&---------------------------------------------------------------------*
*&      Form  OBJ_READ_TABLETYPE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_DD40VD_OBJ1  text
*      -->P_DD42VD_OBJ1  text
*      -->P_OBJNAME  text
*      -->P_VERSNO1  text
*      -->P_SPACE  text
*      -->P_TECHNICAL_VIEW  text
*      <--P_RC  text
*----------------------------------------------------------------------*
FORM obj_read_tabletype
     TABLES   dd40vd_tab STRUCTURE dd40vd
              dd42vd_tab STRUCTURE dd42vd
     USING    objname
              versno
              log_dest
              technical_view    TYPE      c        " uh, 18.08.1999
     CHANGING rc.

  DATA: dd42v_tab LIKE dd42v OCCURS 0 WITH HEADER LINE.
  DATA: dd40v_tab LIKE dd40v OCCURS 0 WITH HEADER LINE.
  DATA: dd40tv_tab LIKE dd40tv OCCURS 0 WITH HEADER LINE.

  DATA: reftype TYPE dd40vd-reftype.               " uh, 25.10.2000

  CLEAR: rc.

  CALL FUNCTION 'SVRS_GET_VERSION_TTYD_40'
       EXPORTING
            destination = log_dest
            object_name = objname
            versno = versno
*      IMPORTING
*           INFO_LINE = I01
       TABLES
            dd40v_tab = dd40v_tab
            dd42v_tab = dd42v_tab
            dd40tv_tab = dd40tv_tab
       EXCEPTIONS
            no_version = 01.
  IF sy-subrc <> 0.
    rc = 1.
    EXIT.
  ENDIF.
  fill_sy_langu_text1 40 typename.

  " Header:
  LOOP AT dd40v_tab.
    CLEAR dd40vd_tab.                 " uh, 18.08.1999

    MOVE-CORRESPONDING dd40v_tab TO dd40vd_tab.

    " uh, 18.08.1999: Anfang
    " Bem.: In der techn. Darstellung wird der Inhalt unver#ndert
    "       dargestellt, ohne Erg#nzungen, ... .
    "       In der normalen Sicht f#r Versionsanzeige und Vergleich
    "       werden einige Felder textuell aufbereitet und Versions-
    "       unterschiede aufgrund von Erweiterungen der Struktur
    "       oder #nderungen im Verfahren zum F#llen der Felder
    "      'gegl#ttet'.
    IF technical_view IS INITIAL.
      " - Textuelle Darstellung von codierten Feldern:
      " -- ROWKIND mithilfe der Festwerttexte zu Dom#ne 'TYPEKIND':
      PERFORM get_fv_text(radvvutl)
              USING    'TYPEKIND' dd40vd_tab-rowkind
              CHANGING dd40vd_tab-rowkindtxt rc.
      " uh, 25.10.2000: Handle additional technical field REFTYPE:
      " -- REFTYPE is shown by the fixed values texts for domain
      "    'DDREFTYPE':
      IF     dd40vd_tab-reftype = space
         AND dd40vd_tab-rowkind = rowkind_reftype.
        " We can decide if it is a generic reference type:
        get_generic_reftype dd40vd_tab-rowtype reftype.
        " if reftype is initial. -> no generic reference type
        " -> No information about the referenced objects type
        "    (it could be a class or an interface)
        " -> There may be shown a difference to a version which
        "    has REFTYPE filled even if there is no difference,
        "    but we do not have another chance ...
      ELSE.
        reftype = dd40vd_tab-reftype.
      ENDIF.
      PERFORM get_fv_text(radvvutl)
              USING    'DDREFTYPE' reftype
              CHANGING dd40vd_tab-reftypetxt rc.
      " -- TTYPKIND mithilfe der Festwerttexte zu Dom#ne 'TTYPKIND':
      PERFORM get_fv_text(radvvutl)
              USING    'TTYPKIND' dd40vd_tab-ttypkind
              CHANGING dd40vd_tab-ttypkintxt rc.
      " -- ACCESSMODE mithilfe der Festw.texte zu Dom. 'ACCESSMODE':
      PERFORM get_fv_text(radvvutl)
              USING    'ACCESSMODE' dd40vd_tab-accessmode
              CHANGING dd40vd_tab-accmodetxt rc.
      " -- TTYPKEYDEF mithilfe der Festw.texte zu Dom. 'TTYPKEYDEF':
      PERFORM get_fv_text(radvvutl)
              USING    'TTYPKEYDEF' dd40vd_tab-keydef
              CHANGING dd40vd_tab-keydeftxt rc.
      " -- KEYKIND mithilfe der Festwerttexte zu Dom#ne 'KEYKIND':
      PERFORM get_fv_text(radvvutl)
              USING    'KEYKIND' dd40vd_tab-keykind
              CHANGING dd40vd_tab-keykindtxt rc.
      " - F#r Ranges-Tabellentypen mit direkter Typeingabe f#r den
      "   Bezugstyp:
      "   Abb. von DATATYPE, LENG, ... auf CTDATATYPE, CTLENG,...
      "   ist bereits durch die DD-Schnittstellen durchgef#hrt und
      "   auch so in der Versionsverwaltung abgespeichert.
      " - F#r Ranges-Tabellentypen mit Datenelement als Bezugstyp:
      "   Zur#cksetzen der aus RANGE_CTYP abgeleiteten Feldinhalte:
      IF     dd40vd_tab-ttypkind = src_ttypkind_rangesttyp
         AND NOT ( dd40vd_tab-range_ctyp IS INITIAL ).
        CLEAR: dd40vd_tab-ctdatatype, dd40vd_tab-ctleng,
               dd40vd_tab-ctdecimals.
      ENDIF.
      " - Zur#cksetzen der aus ROWTYPE abgeleiteten Feldinhalte:
      IF dd40vd_tab-rowkind <> rowkind_directtype.
        CLEAR: dd40vd_tab-datatype, dd40vd_tab-leng,
               dd40vd_tab-decimals.
      ENDIF.
    ENDIF.
    " uh, 18.08.1999: Ende

    APPEND dd40vd_tab.
  ENDLOOP.

  " Schl#sselkomponenten:
  LOOP AT dd42v_tab.
    CLEAR dd42vd_tab.                 " uh, 18.08.1999
    " Bem.: Technische Sicht ist gleich der normalen Sicht.
    MOVE-CORRESPONDING dd42v_tab TO dd42vd_tab.
    APPEND dd42vd_tab.
  ENDLOOP.
ENDFORM.                    " OBJ_READ_TABLETYPE
*&---------------------------------------------------------------------*
*&      Form  GET_DEVCLASS_TABLETYPE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM get_devclass_tabletype .

  SELECT obj_name
    FROM tadir
    INTO CORRESPONDING FIELDS OF TABLE gt_e071_t
   WHERE pgmid    =  'R3TR'
     AND object   =  'TTYP'
     AND devclass IN s_dev
     AND obj_name IN gr_objnm
     AND delflag   = space.

  LOOP AT gt_e071_t.

    MOVE-CORRESPONDING gt_e071_t TO gt_e071.
    gt_e071-pgmid  = 'LIUM'.
    gt_e071-object = 'TTYD'.
    APPEND gt_e071.

  ENDLOOP.

ENDFORM.                    " GET_DEVCLASS_TABLETYPE
*&---------------------------------------------------------------------*
*&      Form  GET_DEVCLASS_ELEMENT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM get_devclass_element .

  SELECT obj_name
    FROM tadir
    INTO CORRESPONDING FIELDS OF TABLE gt_e071_t
   WHERE pgmid    =  'R3TR'
     AND object   =  'DTEL'
     AND devclass IN s_dev
     AND obj_name IN gr_objnm
     AND delflag   = space.

  LOOP AT gt_e071_t.

    MOVE-CORRESPONDING gt_e071_t TO gt_e071.
    gt_e071-pgmid  = 'LIUM'.
    gt_e071-object = 'DTEL'.
    APPEND gt_e071.

  ENDLOOP.

ENDFORM.                    " GET_DEVCLASS_ELEMENT
*&---------------------------------------------------------------------*
*&      Form  GET_DEVCLASS_DOMAIN
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM get_devclass_domain .

  SELECT obj_name
    FROM tadir
    INTO CORRESPONDING FIELDS OF TABLE gt_e071_t
   WHERE pgmid    =  'R3TR'
     AND object   =  'DOMA'
     AND devclass IN s_dev
     AND obj_name IN gr_objnm
     AND delflag   = space.

  LOOP AT gt_e071_t.

    MOVE-CORRESPONDING gt_e071_t TO gt_e071.
    gt_e071-pgmid  = 'LIUM'.
    gt_e071-object = 'DOMA'.
    APPEND gt_e071.

  ENDLOOP.

ENDFORM.                    " GET_DEVCLASS_DOMAIN
*&---------------------------------------------------------------------*
*&      Form  COMPARE_ELEMENT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_GT_E071  text
*----------------------------------------------------------------------*
FORM compare_element  USING    ps_e071 TYPE e071.

  DATA: lv_object_name  TYPE vrsd-objname,
        lv_versno       TYPE vrsd-versno,
        lv_rc_l         TYPE sy-subrc,
        lv_rc_r         TYPE sy-subrc,
        lt_dd04vd_l     TYPE TABLE OF dd04vd,
        lt_dd04vd_r     TYPE TABLE OF dd04vd.


  lv_object_name = ps_e071-obj_name.
  lv_versno      = '00000'.

  CLEAR: lv_local, lv_remote.

  " local
  PERFORM obj_read_element
          TABLES   lt_dd04vd_l
          USING    lv_object_name lv_versno space
                   space
          CHANGING lv_rc_l.
  IF lv_rc_l IS NOT INITIAL.
    lv_local = 'X'.
  ENDIF.

  " remote
  PERFORM obj_read_element
          TABLES   lt_dd04vd_r
          USING    lv_object_name lv_versno destination
                   space
          CHANGING lv_rc_r.
  IF lv_rc_r IS NOT INITIAL.
    lv_remote = 'X'.
  ENDIF.

  DATA: lv_exit.
  PERFORM write_message USING    ps_e071 lv_local lv_remote
                        CHANGING lv_exit.
  CHECK lv_exit IS INITIAL.

  " table 비교
  IF lt_dd04vd_l[] = lt_dd04vd_r[].

    IF cb_all = 'X'.
      PERFORM write_message_same USING ps_e071-obj_name ps_e071-object.
    ENDIF.
    ADD 1 TO gs_cnt-same.
    EXIT.
  ENDIF.

  PERFORM write_message_different USING ps_e071-obj_name ps_e071-object.

*  상세출력여부..
  CHECK cb_detal = 'X'.

  SUBMIT radvvde2
          WITH objname  = lv_object_name
          WITH versno1  = lv_versno
          WITH versno2  = lv_versno
          WITH log_dest = destination
          WITH rem_syst = remote_system
          AND RETURN.

ENDFORM.                    " COMPARE_ELEMENT
*&---------------------------------------------------------------------*
*&      Form  OBJ_READ_ELEMENT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_LT_DD40VD_L  text
*      -->P_LT_DD42VD_L  text
*      -->P_LV_OBJECT_NAME  text
*      -->P_LV_VERSNO  text
*      -->P_SPACE  text
*      -->P_SPACE  text
*      <--P_LV_RC_L  text
*----------------------------------------------------------------------*
FORM obj_read_element
     TABLES   dd04vd_tab        STRUCTURE dd04vd
     USING    objname
              versno
              log_dest
              technical_view    TYPE      c        " uh, 18.08.1999
     CHANGING rc.

  DATA dd04v_tab LIKE dd04v OCCURS 0 WITH HEADER LINE.
  DATA dd04tv_tab LIKE dd04tv OCCURS 0 WITH HEADER LINE.
  DATA: refkind LIKE dd04l-refkind,
        reftype LIKE dd04l-reftype.         " uh, 25.10.2000

  CLEAR: rc.

  CALL FUNCTION 'SVRS_GET_VERSION_DTED_40'
       EXPORTING
            destination = log_dest
            object_name = objname
            versno = versno
*         IMPORTING
*            INFO_LINE = I01
       TABLES
            dd04v_tab = dd04v_tab
            dd04tv_tab = dd04tv_tab
       EXCEPTIONS
            no_version = 01.
  fill_sy_langu_text1 04 rollname.
  IF sy-subrc <> 0.
    rc = 1.
    EXIT.
  ENDIF.
  LOOP AT dd04v_tab.
    " uh, 18.08.1999:
    " bisher: CLEAR DD04VD_TAB-TXTMNT.
    CLEAR dd04vd_tab.

    MOVE-CORRESPONDING dd04v_tab TO dd04vd_tab.
    IF dd04v_tab-scrlen1 <> 0 OR
       dd04v_tab-scrlen2 <> 0 OR
       dd04v_tab-scrlen3 <> 0 OR
       dd04v_tab-headlen <> 0.
      dd04vd_tab-txtmnt = 'X'.
    ELSE.
      CLEAR: dd04vd_tab-scrtext_s,
             dd04vd_tab-scrtext_m,
             dd04vd_tab-scrtext_l,
             dd04vd_tab-reptext.
    ENDIF.

    " uh, 18.08.1999: Anfang
    " Bem.: In der techn. Darstellung wird der Inhalt unver#ndert
    "       dargestellt, ohne Erg#nzungen, ... .
    "       In der normalen Sicht f#r Versionsanzeige und Vergleich
    "       werden einige Felder textuell aufbereitet und Versions-
    "       unterschiede aufgrund von Erweiterungen der Struktur
    "       oder #nderungen im Verfahren zum F#llen der Felder
    "      'gegl#ttet'.
    IF technical_view IS INITIAL.
      " - Textuelle Darstellung von REFKIND mithilfe der
      "   Festwerttexte zu Dom#ne 'TYPEKIND':
      IF dd04vd_tab-refkind = space AND dd04vd_tab-domname <> space.
        refkind = refkind_doma.
      ELSE.
        refkind = dd04vd_tab-refkind.
      ENDIF.
      PERFORM get_fv_text(radvvutl)
              USING    'TYPEKIND' refkind
              CHANGING dd04vd_tab-refkindtxt rc.

      " - Textuelle Darstellung von REFREFTYPE mithilfe der
      "   Festwerttexte zu Dom#ne 'DDREFTYPE':
      IF     dd04vd_tab-reftype = space
         AND dd04vd_tab-refkind = refkind_reftype.
        " We can decide if it is a generic reference type:
        get_generic_reftype dd04vd_tab-domname reftype.
        " if reftype is initial. -> no generic reference type
        " -> No information about the referenced objects type
        "    (it could be a class or an interface)
        " -> There may be shown a difference to a version which
        "    has REFTYPE filled even if there is no difference,
        "    but we do not have another chance ...
      ELSE.
        reftype = dd04v_tab-reftype.
      ENDIF.
      PERFORM get_fv_text(radvvutl)
              USING    'DDREFTYPE' reftype
              CHANGING dd04vd_tab-reftypetxt rc.

      " - Zur#cksetzen der aus DOMNAME abgeleiteten Feldinhalte:
      "   (Achtung: vor der Aufschl#sselung von DOMNAME !)
      IF     NOT ( dd04vd_tab-domname IS INITIAL )
         AND dd04vd_tab-refkind <> refkind_elemtype.
        CLEAR: dd04vd_tab-datatype, dd04vd_tab-leng,
               dd04vd_tab-decimals.
      ENDIF.

      " - Aufschl#sselung von DOMNAME:
      IF dd04vd_tab-refkind = refkind_reftype.
        dd04vd_tab-reftypname = dd04vd_tab-domname.
        CLEAR dd04vd_tab-domname.
        " sp#ter auch: elseif dd04vd_tab-refkind = refkind_elemtype.
        "   dd04vd_tab-dtelname = dd04vd_tab-domname.
        "   clear dd04vd_tab-domname.
      ENDIF.
    ENDIF.
    " uh, 18.08.1999: Ende

    APPEND dd04vd_tab.
  ENDLOOP.
ENDFORM.                    " OBJ_READ_ELEMENT
*&---------------------------------------------------------------------*
*&      Form  COMPARE_DOMAIN
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_GT_E071  text
*----------------------------------------------------------------------*
FORM compare_domain  USING    ps_e071 TYPE e071.

  DATA: lv_object_name  TYPE vrsd-objname,
        lv_versno       TYPE vrsd-versno,
        lv_rc_l         TYPE sy-subrc,
        lv_rc_r         TYPE sy-subrc,
        lt_dd01vd_l     TYPE TABLE OF dd01vd,
        lt_dd07vd_l     TYPE TABLE OF dd07vd,
        lt_dd01vd_r     TYPE TABLE OF dd01vd,
        lt_dd07vd_r     TYPE TABLE OF dd07vd.


  lv_object_name = ps_e071-obj_name.
  lv_versno      = '00000'.

  CLEAR: lv_local, lv_remote.

  " local
  PERFORM obj_read_domain
          TABLES   lt_dd01vd_l lt_dd07vd_l
          USING    lv_object_name lv_versno space
          CHANGING lv_rc_l.
  IF lv_rc_l IS NOT INITIAL.
    lv_local = 'X'.
  ENDIF.

  " remote
  PERFORM obj_read_domain
          TABLES   lt_dd01vd_r lt_dd07vd_r
          USING    lv_object_name lv_versno destination
          CHANGING lv_rc_r.
  IF lv_rc_r IS NOT INITIAL.
    lv_remote = 'X'.
  ENDIF.

  DATA: lv_exit.
  PERFORM write_message USING    ps_e071 lv_local lv_remote
                        CHANGING lv_exit.
  CHECK lv_exit IS INITIAL.

  " table 비교
  IF lt_dd01vd_l[] = lt_dd01vd_r[] AND lt_dd07vd_l[] = lt_dd07vd_r[].

    IF cb_all = 'X'.
      PERFORM write_message_same USING ps_e071-obj_name ps_e071-object.
    ENDIF.
    ADD 1 TO gs_cnt-same.
    EXIT.
  ENDIF.

  PERFORM write_message_different USING ps_e071-obj_name ps_e071-object.

*  상세출력여부..
  CHECK cb_detal = 'X'.

  SUBMIT radvvdo2
          WITH objname  = lv_object_name
          WITH versno1  = lv_versno
          WITH versno2  = lv_versno
          WITH log_dest = destination
          WITH rem_syst = remote_system
          AND RETURN.

ENDFORM.                    " COMPARE_DOMAIN
*&---------------------------------------------------------------------*
*&      Form  OBJ_READ_DOMAIN
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_LT_DD04VD_L  text
*      -->P_LV_OBJECT_NAME  text
*      -->P_LV_VERSNO  text
*      -->P_SPACE  text
*      -->P_SPACE  text
*      <--P_LV_RC_L  text
*----------------------------------------------------------------------*
FORM obj_read_domain
     TABLES dd01vd_tab STRUCTURE dd01vd
            dd07vd_tab STRUCTURE dd07vd
      USING objname versno log_dest
      CHANGING rc.

  DATA: dd07v_tab LIKE dd07v OCCURS 0 WITH HEADER LINE.
  DATA: dd01v_tab LIKE dd01v OCCURS 0 WITH HEADER LINE.
  DATA: dd07tv_tab LIKE dd07tv OCCURS 0 WITH HEADER LINE.
  DATA: dd01tv_tab LIKE dd01tv OCCURS 0 WITH HEADER LINE.

  CLEAR: rc.

  CALL FUNCTION 'SVRS_GET_VERSION_DOMD_40'
       EXPORTING
            destination = log_dest
            object_name = objname
            versno = versno
*      IMPORTING
*           INFO_LINE = I01
       TABLES
            dd01v_tab = dd01v_tab
            dd07v_tab = dd07v_tab
            dd01tv_tab = dd01tv_tab
            dd07tv_tab = dd07tv_tab
       EXCEPTIONS
            no_version = 01.
  IF sy-subrc <> 0.
    rc = 1.
    EXIT.
  ENDIF.

  fill_sy_langu_text1 01 domname.
  fill_sy_langu_text2 07 domname domvalue_l.

  READ TABLE dd01v_tab INDEX 1.
  IF dd01v_tab-valexi = space.
    REFRESH dd07v_tab.
  ENDIF.
  LOOP AT dd01v_tab.
    MOVE-CORRESPONDING dd01v_tab TO dd01vd_tab.
    APPEND dd01vd_tab.
  ENDLOOP.
  LOOP AT dd07v_tab.
    MOVE-CORRESPONDING dd07v_tab TO dd07vd_tab.
    APPEND dd07vd_tab.
  ENDLOOP.

ENDFORM.                    " OBJ_READ_DOMAIN
*&---------------------------------------------------------------------*
*&      Form  WRITE_MESSAGE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_PS_E071  text
*      -->P_LV_LOCAL  text
*      -->P_LV_REMOTE  text
*      <--P_LV_EXIT  text
*----------------------------------------------------------------------*
FORM write_message  USING    ps_e071     TYPE e071
                             pv_local
                             pv_remote
                    CHANGING pv_exit.

  DATA: lv_len        TYPE i,
        lv_area       TYPE enlfdir-area,
        lr_obj_name   TYPE RANGE OF e071-obj_name,
        lr_obj_name_l LIKE LINE OF lr_obj_name.

  pv_exit = 'X'.

  CLEAR: gs_h_data.
  gs_h_data-objtype = ps_e071-object.
  gs_h_data-objname = ps_e071-obj_name.

  " 양쪽에 없는 경우 Skip.
  IF pv_local = 'X' AND pv_remote = 'X'.
    WRITE:/ ps_e071-obj_name, ps_e071-object,
          ` : Together Source Not Exist !`.
    HIDE gs_h_data.
    ADD  1   TO gs_cnt-together.
    EXIT.
  ENDIF.

  " Local 에만 없는 경우..
  IF pv_local = 'X'.
    WRITE:/ ps_e071-obj_name COLOR 7, ps_e071-object,
          ` : Local Source Not Exist !`.
    HIDE gs_h_data.
    ADD  1   TO gs_cnt-error.
    EXIT.
  ENDIF.

  " Remote 에만 없는 경우
  IF pv_remote = 'X'.
    WRITE:/ ps_e071-obj_name COLOR 3, ps_e071-object.
    HIDE gs_h_data.

    IF gv_inc_check = 'X'.
      CASE ps_e071-object.
        WHEN 'FUNC'.
          CLEAR lv_area.
          SELECT SINGLE area
            FROM enlfdir
            INTO lv_area
           WHERE funcname = ps_e071-obj_name.

        WHEN 'REPS'.
          IF ps_e071-obj_name+0(2) = 'LZ'    OR ps_e071-obj_name+0(2) = 'LY'.
            lv_area = ps_e071-obj_name+1(32).
            lv_len  = STRLEN( lv_area ) - 3.
            lv_area = lv_area+0(lv_len).

          ELSEIF ps_e071-obj_name+0(5) = 'SAPLZ' OR ps_e071-obj_name+0(5) = 'SAPLY'.
            lv_area = ps_e071-obj_name+4(32).
          ELSE.
            lv_area = ps_e071-obj_name.
          ENDIF.

        WHEN OTHERS.
          lv_area = ps_e071-obj_name.
      ENDCASE.

      CLEAR: lr_obj_name[], lr_obj_name_l.
      lr_obj_name_l-sign    = 'I'.
      lr_obj_name_l-option  = 'EQ'.
      lr_obj_name_l-low     = lv_area.
      APPEND lr_obj_name_l TO lr_obj_name.

      IF lv_area <> ps_e071-obj_name.
        lr_obj_name_l-low     = ps_e071-obj_name.
        APPEND lr_obj_name_l TO lr_obj_name.
      ENDIF.

      SELECT COUNT( * )
        FROM e071
        INTO sy-dbcnt
       WHERE trkorr   IN gr_trkorr
         AND obj_name IN lr_obj_name.
      IF sy-subrc NE 0 OR sy-dbcnt = 0.
        WRITE: ` : Remote Source Not Exist !` COLOR 6.
      ELSE.
        WRITE: ` : Remote Source Not Exist !`.
      ENDIF.
    ELSE.
      WRITE: ` : Remote Source Not Exist !`.
    ENDIF.

    ADD  1   TO gs_cnt-check.
    EXIT.
  ENDIF.

  pv_exit = space.

ENDFORM.                    " WRITE_MESSAGE
*&---------------------------------------------------------------------*
*&      Form  ADD_WHERE_USED_LIST
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_LS_INCLU_NAME  text
*----------------------------------------------------------------------*
FORM add_where_used_list  USING    pv_name.

  DATA: ls_e071      TYPE e071,
        lt_e071      TYPE TABLE OF e071,
        ls_wbcrossgt TYPE wbcrossgt,
        lt_wbcrossgt TYPE TABLE OF wbcrossgt.

  SELECT include
         name
         otype
    FROM wbcrossgt
    INTO CORRESPONDING FIELDS OF TABLE lt_wbcrossgt
   WHERE include = pv_name
     AND ( name LIKE 'Z%' OR name LIKE 'Y%' ).
  CHECK sy-subrc = 0.

  LOOP AT lt_wbcrossgt INTO ls_wbcrossgt.

    CASE ls_wbcrossgt-otype.
      WHEN 'TY'.
        SELECT SINGLE pgmid
                      object
                      obj_name
          FROM tadir
          INTO CORRESPONDING FIELDS OF ls_e071
         WHERE obj_name = ls_wbcrossgt-name
           AND delflag  = space.
        IF sy-subrc = 0.

          CASE ls_e071-object.
            WHEN 'CLAS'.
              PERFORM get_object_clas TABLES lt_e071
                                      USING  ls_e071-obj_name.
              APPEND LINES OF lt_e071 TO gt_e071.

            WHEN OTHERS.          APPEND ls_e071 TO gt_e071.
          ENDCASE.
        ENDIF.

      WHEN 'ME'.
        ls_e071-obj_name = ls_wbcrossgt-name.
        PERFORM get_object_where_me TABLES lt_e071
                                    USING  ls_e071-obj_name.
        APPEND LINES OF lt_e071 TO gt_e071.

      WHEN OTHERS.
    ENDCASE.

  ENDLOOP.

ENDFORM.                    " ADD_WHERE_USED_LIST
*&---------------------------------------------------------------------*
*&      Form  GET_OBJECT_CLAS
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_LT_E071  text
*      -->P_LS_E071_OBJ_NAME  text
*----------------------------------------------------------------------*
FORM get_object_clas  TABLES   pt_e071 STRUCTURE e071
                      USING    pv_obj_name.

  DATA: ls_e071  TYPE e071.

  CLEAR: pt_e071[].
  SELECT DISTINCT objtype AS object
                  objname AS obj_name
    FROM vrsd
    APPENDING CORRESPONDING FIELDS OF TABLE pt_e071
   WHERE objname = pv_obj_name.

  ls_e071-pgmid  = 'LIUM'.
  MODIFY pt_e071 FROM ls_e071
         TRANSPORTING pgmid
         WHERE pgmid = space.

ENDFORM.                    " GET_OBJECT_CLAS
*&---------------------------------------------------------------------*
*&      Form  GET_OBJECT_WHERE_ME
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_LT_E071  text
*      -->P_LS_E071_OBJ_NAME  text
*----------------------------------------------------------------------*
FORM get_object_where_me  TABLES   pt_e071 STRUCTURE e071
                          USING    pv_obj_name.

  DATA: ls_cpdkey   TYPE seocpdkey,
        ls_e071     TYPE e071,
        lt_e071     TYPE TABLE OF e071.

  CLEAR: pt_e071[].

  CHECK pv_obj_name IS NOT INITIAL.

  SPLIT pv_obj_name AT '\ME:' INTO ls_cpdkey-clsname ls_cpdkey-cpdname.
  CHECK ls_cpdkey-clsname IS NOT INITIAL.

  PERFORM get_object_clas TABLES lt_e071
                          USING  ls_cpdkey-clsname.

  CHECK ls_cpdkey-cpdname IS NOT INITIAL.

  ls_e071-pgmid    = 'LIUM'.
  ls_e071-object   = 'METH'.
  ls_e071-obj_name = ls_cpdkey.
  APPEND ls_e071  TO lt_e071.

  " parameter 에 CBO Type 이 있는 경우
  PERFORM add_object_method USING ls_cpdkey.

  APPEND LINES OF lt_e071 TO pt_e071.

ENDFORM.                    " GET_OBJECT_WHERE_ME
*&---------------------------------------------------------------------*
*&      Form  WRITE_MESSAGE_SAME
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_PS_E071_OBJ_NAME  text
*      -->P_PS_E071_OBJECT  text
*----------------------------------------------------------------------*
FORM write_message_same  USING    pv_obj_name
                                  pv_object.

  CLEAR: gs_h_data.
  gs_h_data-objtype = pv_object.
  gs_h_data-objname = pv_obj_name.

  WRITE:/ pv_obj_name, pv_object, ` : The Two Sources is Same`.
  HIDE gs_h_data.

ENDFORM.                    " WRITE_MESSAGE_SAME
*&---------------------------------------------------------------------*
*&      Form  WRITE_MESSAGE_DIFFERENT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*      -->P_PS_E071_OBJ_NAME  text
*      -->P_PS_E071_OBJECT  text
*----------------------------------------------------------------------*
FORM write_message_different  USING    pv_obj_name
                                       pv_object.

  CLEAR: gs_h_data.
  gs_h_data-objtype = pv_object.
  gs_h_data-objname = pv_obj_name.

  WRITE:/ pv_obj_name COLOR 6, pv_object,
        ` : The Two Sources is Different`.
  ADD  1  TO gs_cnt-wrong.
  HIDE gs_h_data.

ENDFORM.                    " WRITE_MESSAGE_DIFFERENT
*&---------------------------------------------------------------------*
*&      Form  COMPARE_VIEW_TABLE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM compare_view_table .

  DATA: lv_versno      TYPE vrsd-versno.

  lv_versno      = '00000'.

  SUBMIT rsvrstb2
          WITH objname  = gs_h_data-objname
          WITH versno1  = lv_versno
          WITH versno2  = lv_versno
          WITH log_dest = destination
          WITH rem_syst = remote_system
          AND RETURN.

ENDFORM.                    " COMPARE_VIEW_TABLE
*&---------------------------------------------------------------------*
*&      Form  COMPARE_VIEW_VIEW
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM compare_view_view .

  DATA: lv_versno      TYPE vrsd-versno.

  lv_versno      = '00000'.

  SUBMIT rsvrsvi2
          WITH objname  = gs_h_data-objname
          WITH versno1  = lv_versno
          WITH versno2  = lv_versno
          WITH log_dest = destination
          WITH rem_syst = remote_system
          AND RETURN.

ENDFORM.                    " COMPARE_VIEW_VIEW
*&---------------------------------------------------------------------*
*&      Form  COMPARE_VIEW_TABLETYPE
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM compare_view_tabletype .

  DATA: lv_versno      TYPE vrsd-versno.

  lv_versno      = '00000'.

  SUBMIT radvvty2
          WITH objname  = gs_h_data-objname
          WITH versno1  = lv_versno
          WITH versno2  = lv_versno
          WITH log_dest = destination
          WITH rem_syst = remote_system
          AND RETURN.

ENDFORM.                    " COMPARE_VIEW_TABLETYPE
*&---------------------------------------------------------------------*
*&      Form  COMPARE_VIEW_ELEMENT
*&---------------------------------------------------------------------*
*       text
*----------------------------------------------------------------------*
*  -->  p1        text
*  <--  p2        text
*----------------------------------------------------------------------*
FORM compare_view_element .

  DATA: lv_versno      TYPE vrsd-versno.

  lv_versno      = '00000'.

  SUBMIT radvvde2
          WITH objname  = gs_h_data-objname
          WITH versno1  = lv_versno
          WITH versno2  = lv_versno
          WITH log_dest = destination
          WITH rem_syst = remote_system
          AND RETURN.

ENDFORM.                    " COMPARE_VIEW_ELEMENT
*&---------------------------------------------------------------------*
